{
  "name": "detake-web",
  "type": "module",
  "version": "1.0.0",
  "description": "DeTake - Crypto News and Analysis Platform",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "vercel dev",
    "vercel:simulate": "pnpm build && pnpm start",
    "astro": "astro",
    "type-check": "astro check",
    "check:no-chinese-us": "node check-no-chinese-us.js",
    "check:spelling": "cspell --config package.json --no-progress \"src/**/*.{ts,tsx,js,jsx,astro}\"",
    "prepare": "simple-git-hooks",
    "test": "playwright test tests/e2e/",
    "test:e2e": "playwright test tests/e2e/",
    "test:health": "playwright test tests/content-health/",
    "test:ui-anomaly": "playwright test tests/ui-anomaly/",
    "test:integration": "playwright test tests/integration/",
    "test:a11y": "playwright test tests/a11y/",
    "test:perf": "playwright test tests/performance/",
    "test:all": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:report": "playwright show-report",
    "dev-test": "./dev-test.sh",
    "commit": "./dev-commit.sh"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.4.2",
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/vercel": "^8.2.6",
    "@clerk/clerk-react": "^5.47.0",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-toast": "^1.0.0",
    "@sentry/astro": "^10.33.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/analytics": "^1.5.0",
    "astro": "^5.13.2",
    "astro-i18next": "^1.0.0-beta.21",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.23.12",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-backend": "^3.0.2",
    "joi": "^17.11.0",
    "jotai": "^2.0.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.400.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^15.6.0",
    "react-is": "^19.2.1",
    "recharts": "^3.1.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^4.1.11",
    "turndown": "^7.2.2",
    "typescript": "^5.9.2",
    "vite-plugin-node-polyfills": "^0.24.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@rollup/plugin-inject": "^5.0.5",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/turndown": "^5.0.6",
    "cspell": "^8.17.0",
    "pg": "^8.20.0",
    "simple-git-hooks": "^2.11.1",
    "terser": "^5.44.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm check:no-chinese-us && pnpm check:spelling"
  },
  "cspell": {
    "version": "0.2",
    "language": "en,en-US",
    "allowCompoundWords": true,
    "useGitignore": true,
    "dictionaries": [
      "softwareTerms",
      "typescript",
      "css",
      "html"
    ],
    "ignorePaths": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.astro/**",
      "**/public/locales/**",
      "**/docs/**",
      "**/*.svg",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.ico"
    ],
    "words": [
      "amdol",
      "AMDOL",
      "Bingbot",
      "Blzp",
      "defi",
      "DeFi",
      "Español",
      "Français",
      "Русский",
      "العربية",
      "astro",
      "Astro",
      "detake",
      "DeTake",
      "Fusaka",
      "i18n",
      "i18next",
      "imgs",
      "ipcountry",
      "KUBINEC",
      "Pectra",
      "tailwind",
      "Tailwind",
      "pnpm",
      "qqmg",
      "rdfa",
      "reinit",
      "SBTC",
      "vistor",
      "vercel",
      "Vercel",
      "Whyb",
      "whyb",
      "XVCJ",
      "Forex",
      "fingerprintjs",
      "youtu"
    ]
  },
  "packageManager": "pnpm@9.15.3+sha512.1f79bc245a66eb0b07c5d4d83131240774642caaa86ef7d0434ab47c0d16f66b04e21e0c086eb61e62c77efc4d7f7ec071afad3796af64892fae66509173893a"
}
