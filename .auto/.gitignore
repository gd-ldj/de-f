# Keep only AUTO defaults and empty placeholders under version control.
*
!.gitignore
!WORKFLOW.yaml

!qa-units/
qa-units/*
!qa-units/.gitkeep

!queue/
queue/*
!queue/.gitkeep

!reports/
reports/*
!reports/daily/
reports/daily/*
!reports/daily/.gitkeep

!runtime/
runtime/*
!runtime/heartbeat/
runtime/heartbeat/*
!runtime/heartbeat/.gitkeep

!tasks/
tasks/*
!tasks/.gitkeep

!work-items/
work-items/*
!work-items/.gitkeep
