---
import AnalyticsProvider from '../components/common/AnalyticsProvider';
import { Analytics } from '@vercel/analytics/react';
import { SITE_CONFIG } from '@/config/constants';
import { generateHreflangAlternates } from '@/lib/language-utils';

import '../styles/global.css'

import type { Locale, SourceLanguage, TranslationLanguage } from '@/types';

export interface Props {
  title: string
  description?: string
  locale: Locale
  canonicalUrl?: string
  // SEO and social sharing optimization
  ogImage?: string
  ogImageAlt?: string
  ogType?: 'website' | 'article'
  twitterCard?: 'summary' | 'summary_large_image'
  author?: string
  publishedTime?: string
  modifiedTime?: string
  keywords?: string[]
  articleSection?: string
  pageLang?: TranslationLanguage | string
  // Multi-source site architecture
  sourceLanguage?: SourceLanguage
  translationLanguage?: TranslationLanguage | null
  availableTranslations?: TranslationLanguage[]
}

const {
  title,
  description = 'DeTake - News and Analysis',
  locale,
  canonicalUrl,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  author,
  publishedTime,
  modifiedTime,
  keywords,
  articleSection,
  pageLang,
  sourceLanguage,
  translationLanguage,
  availableTranslations
} = Astro.props

type ArticleLanguageCode = 'en' | 'zh' | 'ar' | 'ru' | 'ja'

// 统一使用当前访问域名生成分享与 canonical 链接
const currentOrigin = Astro.url.origin
const rawCanonicalUrl = canonicalUrl ? new URL(canonicalUrl) : Astro.url
const currentUrl = new URL(`${currentOrigin}${rawCanonicalUrl.pathname}${rawCanonicalUrl.search}${rawCanonicalUrl.hash}`).href

// 页面整体语言仍然跟随站点 locale（导航、Footer 等文案），而正文可使用 section 级 lang 区分
const htmlLang = locale === 'zh' ? 'zh' : locale === 'ja' ? 'ja' : 'en'

// Open Graph 语言也采用站点级区域语言
const ogLocale = locale === 'zh' ? 'zh_CN' : locale === 'ja' ? 'ja_JP' : 'en_US'

// 仅在正文语言未显式指定，或与站点默认语言一致时输出 region 级别的 hreflang，避免误标其他语言内容
const regionDefaultLang: ArticleLanguageCode = locale === 'zh' ? 'zh' : locale === 'ja' ? 'ja' : 'en'
const shouldEmitRegionAlternates = !pageLang || pageLang === regionDefaultLang

// Default OG image
const defaultOgImage = 'https://cdn.detake.com/images/social-card.png'
const finalOgImage = ogImage || defaultOgImage

// Generate keywords meta tag
const keywordsContent = keywords ? keywords.join(', ') : 'detake, news, analysis'

const isProductionSite = SITE_CONFIG.ENVIRONMENT === 'web2' || SITE_CONFIG.ENVIRONMENT === 'web3'
const robotsContent = isProductionSite
  ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  : 'noindex, nofollow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'

// Generate hreflang alternates for multi-source architecture
const hreflangAlternates = sourceLanguage && availableTranslations
  ? generateHreflangAlternates(Astro.url, sourceLanguage, availableTranslations)
  : null
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="https://cdn.detake.com/icons/favicon-green.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordsContent} />
    {author && <meta name="author" content={author} />}
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DeTake" />
    <meta property="og:image" content={finalOgImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:locale" content={ogLocale} />
    
    {/* Article-specific Open Graph tags */}
    {ogType === 'article' && (
      <>
        {author && <meta property="article:author" content={author} />}
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {articleSection && <meta property="article:section" content={articleSection} />}
        {keywords && keywords.map(keyword => (
          <meta property="article:tag" content={keyword} />
        ))}
      </>
    )}
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content="@DeTake" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    
    <!-- Other SEO optimizations -->
    <meta name="robots" content={robotsContent} />
    <link rel="image_src" href={finalOgImage} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={currentUrl} />

    {/* Alternate language versions for multi-source architecture */}
    {hreflangAlternates ? (
      <>
        {hreflangAlternates.map((alternate) => (
          <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
        ))}
      </>
    ) : null}
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Buffer polyfill for browser using ESM (real polyfill overrides the shim when loaded) -->
    <script is:inline type="module">
      import { Buffer } from 'https://esm.sh/buffer@6.0.3';
      if (!('Buffer' in window) || (window.Buffer && !window.Buffer.from.toString)) {
        // @ts-ignore - attach to global window for universal access
        window.Buffer = Buffer;
        console.log('[Polyfill] Buffer attached to window via CDN ESM');
      }
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <div class="relative flex min-h-screen flex-col">
      <slot />
    </div>
    
    <!-- SSR-to-client analytics bridge examples -->
    <script is:inline>
      // Example A: Preloaded events queue. Declared by SSR, executed in browser, consumed by AnalyticsProvider.
      window.__ANALYTICS_PRELOADED_EVENTS = (window.__ANALYTICS_PRELOADED_EVENTS || []).concat([
        { type: 'PAGE_VIEW', data: { url: window.location.href, title: document.title, source: 'ssr-preload' } }
      ]);
    </script>
    <div style="display:none" data-analytics-event='{"type":"USER_ENGAGEMENT","data":{"source":"ssr-dom","ts":0}}'></div>

    <AnalyticsProvider client:only="react" />
    <Analytics client:only="react" />
    
    <!-- External Authentication Manager -->
    <script src="/src/scripts/auth-manager.js"></script>

    <!-- Analytics initialization is now handled by AnalyticsProvider React component -->
    
    <!-- External ArticleLink Manager -->
    <script src="/src/scripts/article-link-manager.js"></script>

    <!-- External Timezone Manager -->
    <script src="/src/scripts/timezone-manager.js"></script>
  </body>
</html>
