---
import { fetchHomePageData } from '@/api/articles'
import type { Locale } from '@/types'
import ArticleLink from '@/components/common/astro/ArticleLink.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props as Props

/**
 * Fetch home page data for the news grid
 * Keeps UI fast and SEO friendly.
 */
const homeData = await fetchHomePageData()
const articles = homeData['news_all']

// Static category nav (URLs localized)
const newsCategories = [
  { name: 'All', url: `/${locale}/news`, active: true },
  { name: 'Opinion', url: `/${locale}/news/opinion`, active: false },
  { name: 'Markets', url: `/${locale}/news/markets`, active: false },
  { name: 'Decibels', url: `/${locale}/news/decibels`, active: false },
  { name: 'Exchange', url: `/${locale}/news/exchange`, active: false },
  { name: 'Feature', url: `/${locale}/news/feature`, active: false },
  { name: 'Announcement', url: `/${locale}/news/announcement`, active: false },
  { name: 'People', url: `/${locale}/news/people`, active: false },
  { name: 'Event', url: `/${locale}/news/event`, active: false },
  { name: 'Analysis', url: `/${locale}/news/analysis`, active: false },
  { name: 'Lightspeed Newsletter', url: `/${locale}/news/newsletter`, active: false },
]

/**
 * Format date to a short, localized string for cards
 */
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}
---

<div class="mt-12">
  <div class="flex items-center justify-between mb-6">
  <div class="flex items-center justify-center gap-2">
    <h2 class="text-xl font-medium text-foreground">News</h2>
    <p class="text-sm text-muted-foreground">Breaking headlines across our core coverage categories</p>
  </div>
  <a href={`/${locale}/news`} class="text-primary text-sm font-medium mt-6 hover:text-primary/80 inline-block transition-colors">
      More from News
    </a>
  </div>

  <!-- Category Navigation - 分类导航 -->
  <div class="flex space-x-6 mb-8 overflow-x-auto">
    {newsCategories.map((category) => (
      <a
        href={category.url}
        class={`text-sm whitespace-nowrap px-3 py-1 rounded transition-colors ${
          category.active ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground hover:bg-accent"
        }`}
      >
        {category.name}
      </a>
    ))}
  </div>

  <!-- News Articles Grid - 新闻文章网格 -->
  <div class="grid grid-cols-6 gap-4">
    {articles.map((article) => (
      <ArticleLink
        slug={article.slug}
        category="news"
        locale={locale}
        class="bg-white rounded border border-border overflow-hidden hover:shadow-md transition-shadow group"
      >
        <img 
          src={article.img_url || '/placeholder.svg'}
          alt={article.title} 
          class="w-full h-32 object-cover group-hover:opacity-90 transition-opacity" 
        />
        <div class="p-4">
          <span class="text-xs text-primary font-medium">{article.business_type_name}</span>
          <h3 class="font-medium text-foreground text-sm mt-1 mb-2 leading-tight group-hover:text-primary transition-colors">{article.title}</h3>
          <p class="text-xs text-muted-foreground mb-3">{article.body}</p>
          <div class="flex items-center space-x-2 text-xs text-muted-foreground">
            <span>{formatDate(article.created_at)}</span>
            <span>by {article.author.name}</span>
          </div>
        </div>
      </ArticleLink>
    ))}
  </div>
</div>