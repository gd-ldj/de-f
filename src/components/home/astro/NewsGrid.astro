---

<div class="mt-12">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-bold text-gray-900">News</h2>
    <p class="text-sm text-gray-600">Breaking headlines across our core coverage categories</p>
  </div>

  <!-- Category Navigation - 分类导航 -->
  <div class="flex space-x-6 mb-8 overflow-x-auto">
    {newsCategories.map((category, index) => (
      <a
        href={category.url}
        class={`text-sm whitespace-nowrap px-3 py-1 rounded transition-colors ${
          category.active ? "bg-teal-500 text-white" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"
        }`}
      >
        {category.name}
      </a>
    ))}
  </div>

  <!-- News Articles Grid - 新闻文章网格 -->
  <div class="grid grid-cols-6 gap-4">
    {newsArticles.map((article, index) => (
      <a
        href={article.url}
        class="bg-white rounded-lg border border-gray-200 overflow-hidden hover:shadow-md transition-shadow group"
      >
        <img 
          src={article.image} 
          alt={article.title} 
          class="w-full h-32 object-cover group-hover:opacity-90 transition-opacity" 
        />
        <div class="p-4">
          <span class="text-xs text-teal-600 font-medium">{article.category}</span>
          <h3 class="font-semibold text-gray-900 text-sm mt-1 mb-2 leading-tight group-hover:text-teal-600 transition-colors">{article.title}</h3>
          <p class="text-xs text-gray-600 mb-3">{article.excerpt}</p>
          <div class="flex items-center space-x-2 text-xs text-gray-500">
            <span>{article.date}</span>
            <span>by {article.author}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>