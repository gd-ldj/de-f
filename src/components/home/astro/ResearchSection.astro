---
import type { Locale, HomeMostReadArticle } from '@/types'
import ResearchGrid from '@/components/home/react/ResearchGrid'
import { createTranslator } from '@/lib/i18n'
import { getLocaleFromPath } from '@/lib/utils'

interface Props {
  locale?: Locale
  articles?: HomeMostReadArticle[]
}

const { locale: propsLocale, articles = [] } = Astro.props as Props
const locale: Locale = propsLocale || getLocaleFromPath(Astro.url.pathname) as Locale

// Translation helper function
const t = createTranslator(locale)

/**
 * 使用从父组件传递的文章数据用于 Research 组件
 * 使用 mostread 文章数据
 */
const researchArticles = articles
---

<section class="py-5 px-4 md:px-6 border border-y-0 border-border space-y-6" aria-labelledby="research-heading">
  <div>
    <!-- Top title bar -->
    <div class="flex items-center justify-between mb-2 md:mb-6">
      <div class="flex items-center justify-center gap-2">
        <h2 id="research-heading" class="font-medium text-foreground">
          {t('research.title')}
        </h2>
        <span class="hidden md:block text-muted-foreground">
          {t('research.subtitle')}
        </span>
      </div>
      <a 
        href={`/${locale}/research`}
        class="text-teal-600 hover:text-teal-700 text-sm font-medium transition-colors px-2 py-1"
        aria-label={t('research.readReport')}
      >
        {t('research.moreResearch')}
      </a>
    </div>
    
    <!-- Research grid component -->
    <ResearchGrid 
      articles={researchArticles} 
      locale={locale}
      client:load
    />
  </div>
</section>