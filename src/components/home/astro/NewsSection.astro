---
import type { Locale, HomeNewsArticle } from '@/types'
import NewsGrid from '@/components/home/react/NewsGrid'
import { hasNewsGroups } from '@/components/home/home-section-visibility'

interface Props {
  locale: Locale
  articles?: Array<{
    tag: string;
    data: HomeNewsArticle[];
  }>
}

const { locale, articles = []} = Astro.props as Props
const hasNewsSection = hasNewsGroups(articles)

/**
 * Use articles data or newsData passed from parent component
 * Supports both legacy articles array and new newsData structure
 */
---

{hasNewsSection && (
  <NewsGrid 
    newsData={articles}
    locale={locale}
    client:load
  />
)}
