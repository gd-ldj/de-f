---
import type { Locale, HomeNewsArticle } from '@/types'
import NewsGrid from '@/components/home/react/NewsGrid'

interface Props {
  locale: Locale
  articles?: HomeNewsArticle[]
}

const { locale, articles = [] } = Astro.props as Props

/**
 * Use articles data passed from parent component
 * Provides initial data for the React component
 */
---

<NewsGrid 
  initialArticles={articles} 
  locale={locale}
  client:load
/>