---
// Astro component script (runs at build time)
import { fetchArticles } from '@/api/articles'
import type { Locale } from '@/types'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'
import i18next, { t, changeLanguage } from "i18next";
import ArticleLink from '@/components/common/astro/ArticleLink.astro'

// Get locale from props or default to 'us'
const { locale = 'us' as Locale } = Astro.props
console.log("🚀 ~ i18next----:",t('navigation.allCategories'))

// Fetch articles data for MainContent display
const articlesData = await fetchArticles(locale, 1, 5)
const { articles } = articlesData

// Get the main featured article (first one)
const featuredArticle = articles[0]
// Get the rest for the sidebar articles
const sidebarArticles = articles.slice(1, 3)

/**
 * Format date to readable string
 * @param dateString - ISO date string
 * @returns Formatted date string
 */
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

---

<div class="space-y-6">
  {/* Featured Article */}
  {featuredArticle && (
    <div class="bg-card rounded border border-border overflow-hidden">
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm text-primary font-medium">Highlights</span>
      <span class="text-sm text-muted-foreground uppercase">{featuredArticle.category}</span>
        </div>

        <h2 class="text-2xl font-bold text-foreground mb-4">
          <ArticleLink 
            slug={featuredArticle.slug}
            locale={locale}
            category={featuredArticle.category}
          >
            {featuredArticle.title}
          </ArticleLink>
        </h2>

        <p class="text-muted-foreground mb-4">
          {featuredArticle.excerpt}
        </p>

        <div class="flex items-center space-x-4 text-sm text-muted-foreground mb-6">
          <span>{formatDate(featuredArticle.publishedAt)}</span>
          <span>by {featuredArticle.author.name}</span>
        </div>

        <div class="relative">
          <ArticleLink 
            slug={featuredArticle.slug}
            locale={locale}
            category={featuredArticle.category}
          >
            <img
              src={featuredArticle.featuredImage || '/placeholder.svg'}
              alt={featuredArticle.title}
              class="w-full h-64 object-cover rounded hover:opacity-90 transition-opacity"
            />
          </ArticleLink>
        </div>
      </div>
    </div>
  )}

  {/* Sidebar Articles */}
  <div class="space-y-4">
    {sidebarArticles.map((article) => (
      <div class="bg-card rounded border border-border p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-primary font-medium uppercase">{article.category}</span>
        </div>
        <h3 class="text-lg font-semibold text-foreground mb-2">
          <ArticleLink 
            slug={article.slug}
            locale={locale}
            category={featuredArticle.category}
          >
            {article.title}
          </ArticleLink>
        </h3>
        <p class="text-muted-foreground text-sm mb-3">
          {article.excerpt}
        </p>
        <div class="flex items-center space-x-4 text-xs text-muted-foreground">
          <span>{formatDate(article.publishedAt)}</span>
          <span>by {article.author.name}</span>
        </div>
      </div>
    ))}
  </div>
</div>