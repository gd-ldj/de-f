---
// Astro component script (runs at build time)
import { fetchArticles } from '@/api/articles'
import type { Locale } from '@/types'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'
import i18next, { t, changeLanguage } from "i18next";

// Get locale from props or default to 'us'
const { locale = 'us' as Locale } = Astro.props
console.log("🚀 ~ i18next----:",t('navigation.allCategories'))

// Fetch articles data for MainContent display
const articlesData = await fetchArticles(locale, 1, 5)
const { articles } = articlesData

// Get the main featured article (first one)
const featuredArticle = articles[0]
// Get the rest for the sidebar articles
const sidebarArticles = articles.slice(1, 3)

/**
 * Format date to readable string
 * @param dateString - ISO date string
 * @returns Formatted date string
 */
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

/**
 * Generate article URL with locale and promote code
 * @param slug - Article slug
 * @returns Article URL with promote code parameter
 */
const getArticleUrl = (slug: string) => {
  // Get promote code from localStorage or use default
  let promoteCode = DEFAULT_PROMOTE_CODE
  if (typeof window !== 'undefined') {
    promoteCode = localStorage.getItem(STORAGE_KEYS.PROMOTE_CODE) || DEFAULT_PROMOTE_CODE
  }
  return `/${locale}/news/${slug}-${promoteCode}`
}
---

<div class="space-y-6">
  {/* Featured Article */}
  {featuredArticle && (
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm text-teal-600 font-medium">Highlights</span>
          <span class="text-sm text-gray-500 uppercase">{featuredArticle.category}</span>
        </div>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          <a 
            href={getArticleUrl(featuredArticle.slug)} 
            class="hover:text-teal-600 transition-colors"
          >
            {featuredArticle.title}
          </a>
        </h2>

        <p class="text-gray-600 mb-4">
          {featuredArticle.excerpt}
        </p>

        <div class="flex items-center space-x-4 text-sm text-gray-500 mb-6">
          <span>{formatDate(featuredArticle.publishedAt)}</span>
          <span>by {featuredArticle.author.name}</span>
        </div>

        <div class="relative">
          <a href={getArticleUrl(featuredArticle.slug)}>
            <img
              src={featuredArticle.featuredImage || '/placeholder.svg'}
              alt={featuredArticle.title}
              class="w-full h-64 object-cover rounded-lg hover:opacity-90 transition-opacity"
            />
          </a>
        </div>
      </div>
    </div>
  )}

  {/* Sidebar Articles */}
  <div class="space-y-4">
    {sidebarArticles.map((article) => (
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-teal-600 font-medium uppercase">{article.category}</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">
          <a 
            href={getArticleUrl(article.slug)} 
            class="hover:text-teal-600 transition-colors"
          >
            {article.title}
          </a>
        </h3>
        <p class="text-gray-600 text-sm mb-3">
          {article.excerpt}
        </p>
        <div class="flex items-center space-x-4 text-xs text-gray-500">
          <span>{formatDate(article.publishedAt)}</span>
          <span>by {article.author.name}</span>
        </div>
      </div>
    ))}
  </div>
</div>