---
// Astro component script (runs at build time)
import { fetchHomePageData } from '@/api/articles'
import type { Locale } from '@/types'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'
import ArticleLink from '@/components/common/astro/ArticleLink.astro'

// Get locale from props or default to 'us'
interface Props {
  locale?: Locale;
}

const { locale = 'us' as Locale } = Astro.props as Props

// Fetch home page data
const homeData = await fetchHomePageData()
const { news_all } = homeData
console.log("🚀 ~ lastest:", news_all)

// Get the main featured article (first one)
const featuredArticle = news_all[0]
// Get the rest for the sidebar articles
const sidebarArticles = news_all.slice(1, 3)

/**
 * Format date to readable string
 * @param dateString - ISO date string
 * @returns Formatted date string
 */
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

---

<div class="space-y-6">
  {/* Featured Article */}
  {featuredArticle && (
    <div class="bg-white rounded border border-border overflow-hidden">
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm text-primary font-medium">Highlights</span>
      <span class="text-sm text-muted-foreground uppercase">{featuredArticle.business_type_name}</span>
        </div>

        <h2 class="text-2xl font-medium text-foreground mb-4">
          <ArticleLink 
            slug={featuredArticle.slug}
            locale={locale}
            category="news"
          >
            {featuredArticle.title}
          </ArticleLink>
        </h2>

        <div class="flex items-center space-x-4 text-sm text-muted-foreground mb-6">
          <span>{formatDate(featuredArticle.created_at)}</span>
        </div>

        <div class="relative">
          <ArticleLink 
            slug={featuredArticle.slug}
            locale={locale}
            category="news"
          >
            <img
              src={featuredArticle.img_url || '/placeholder.svg'}
              alt={featuredArticle.title}
              class="w-full h-64 object-cover rounded hover:opacity-90 transition-opacity"
            />
          </ArticleLink>
        </div>
      </div>
    </div>
  )}

  {/* Sidebar Articles */}
  <div class="space-y-4">
    {sidebarArticles.map((article) => (
      <div class="bg-white rounded border border-border p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-primary font-medium uppercase">{article.business_type_name}</span>
        </div>
        <h3 class="text-lg font-medium text-foreground mb-2">
          <ArticleLink 
            slug={article.slug}
            locale={locale}
            category="news"
          >
            {article.title}
          </ArticleLink>
        </h3>
        <div class="flex items-center space-x-4 text-xs text-muted-foreground">
          <span>{formatDate(article.created_at)}</span>
          <span>by {article.author.name}</span>
        </div>
      </div>
    ))}
  </div>
</div>