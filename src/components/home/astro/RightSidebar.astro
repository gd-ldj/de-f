---
// Topics and articles data - 主题和文章数据
const topics = [
  { name: "Data Science", url: "/topics/data-science" },
  { name: "Self Improvement", url: "/topics/self-improvement" },
  { name: "Writing", url: "/topics/writing" },
  { name: "Technology", url: "/topics/technology" },
  { name: "Politics", url: "/topics/politics" },
  { name: "Relationships", url: "/topics/relationships" },
  { name: "Cryptocurrency", url: "/topics/cryptocurrency" },
]

const mustReadArticles = [
  {
    title: "Meta goes to trial to avoid a breakup of Instagram and WhatsApp",
    date: "Apr 11, 2024",
    image: "/placeholder.svg?height=60&width=60",
    url: "/news/meta-trial-instagram-whatsapp"
  },
  {
    title: "Meta goes to trial to avoid a breakup of Instagram and WhatsApp",
    date: "Apr 11, 2024",
    image: "/placeholder.svg?height=60&width=60",
    url: "/news/meta-antitrust-case"
  },
  {
    title: "Meta goes to trial to avoid a breakup of Instagram and WhatsApp",
    date: "Apr 11, 2024",
    image: "/placeholder.svg?height=60&width=60",
    url: "/news/social-media-regulation"
  },
  {
    title: "Meta goes to trial to avoid a breakup of Instagram and WhatsApp",
    date: "Apr 11, 2024",
    image: "/placeholder.svg?height=60&width=60",
    url: "/news/tech-monopoly-debate"
  },
  {
    title: "Meta goes to trial to avoid a breakup of Instagram and WhatsApp",
    date: "Apr 11, 2024",
    image: "/placeholder.svg?height=60&width=60",
    url: "/news/platform-competition"
  },
]
---

<div class="space-y-6 mt-4">
  <div>
    <h4 class="font-semibold text-foreground mb-4">Recommended Topics</h4>
    <div class="flex flex-wrap gap-2">
      {topics.map((topic, index) => (
        <a
          href={topic.url}
          class="px-4 py-3 bg-secondary text-primary text-sm font-medium rounded hover:bg-primary/10 hover:text-primary/80 cursor-pointer transition-all duration-200 text-center border border-border hover:border-primary/20"
        >
          {topic.name}
        </a>
      ))}
    </div>
  </div>

  <div>
    <h4 class="text-xl font-bold text-foreground mb-6">Most Read</h4>
    <div class="space-y-4">
      {mustReadArticles.map((article, index) => (
        <div class="border-b border-border pb-4 last:border-b-0 last:pb-0">
          <a href={article.url} class="flex items-start justify-between group">
            <div class="flex-1 pr-4">
              <div class="flex items-start space-x-3">
                <span class="text-primary font-bold text-lg leading-none mt-1">{index + 1}</span>
                <div class="flex-1">
                  <h5 class="text-foreground font-medium text-base leading-tight mb-2 group-hover:text-primary transition-colors">
                    {article.title}
                  </h5>
                  <div class="flex items-center text-xs text-muted-foreground">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{article.date}</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex-shrink-0">
              <img
                src={article.image || "/placeholder.svg"}
                alt={article.title}
                class="w-16 h-16 rounded object-cover"
              />
            </div>
          </a>
        </div>
      ))}
    </div>
    <a href="/news" class="text-primary text-sm font-medium mt-6 hover:text-primary/80 inline-block transition-colors">
      More from News
    </a>
  </div>
</div>