---
import { fetchHomePageData } from '@/api/articles'
import type { HomeTopic, HomeMostReadArticle, Locale } from '@/types'
import i18next, { t } from 'i18next'
import ArticleLink from '@/components/common/astro/ArticleLink.astro'
import { getLocaleFromPath } from '@/lib/utils'
import {formatDate} from '@/utils/util'

interface Props {
  locale?: Locale
}

// Get locale from props or extract from URL - 从props获取locale或从URL中提取
const { locale: propsLocale } = Astro.props as Props
const locale: Locale = propsLocale || getLocaleFromPath(Astro.url.pathname) as Locale

// Set the language for i18next
i18next.changeLanguage(locale)

// Fetch home page data from API - 从API获取首页数据
const homeData = await fetchHomePageData()

// Extract topics and most read articles from API response - 从API响应中提取主题和热门文章
const rawTopics: HomeTopic[] = homeData?.topics || []
const mostReadArticles: HomeMostReadArticle[] = homeData?.mostread || []

// Transform topics to include URL - 转换主题数据以包含URL
const topics = rawTopics.map(topic => ({
  ...topic,
  url: `${locale}/topics/${topic.name.toLowerCase().replace(/\s+/g, '-')}`
}))
---

<div class="space-y-6">
  <div class="px-6">
    <h4 class="font-medium text-foreground mb-4">{t('common.recommendedTopics')}</h4>
    <div class="flex flex-wrap gap-3">
      {topics.map((topic, index) => (
        <a
          href={topic.url}
          class="px-4 py-3 bg-secondary text-primary text-sm font-medium rounded hover:bg-primary/10 hover:text-primary/80 cursor-pointer transition-all duration-200 text-center border border-border hover:border-primary/20"
        >
          {topic.name}
        </a>
      ))}
    </div>
  </div>

  <div class="px-6 border-t border-border pt-5" >
    <h4 class="font-medium text-foreground mb-4">{t('common.mostRead')}</h4>
    <div class="space-y-4">
      {mostReadArticles.map((article: HomeMostReadArticle, index: number) => (
        <div class="border-b border-border pb-4 last:border-b-0 last:pb-0">
          <ArticleLink
            slug={article.slug}
            business={article.business_type_name.toLowerCase()}
            locale={locale}
            class="flex items-start justify-between group"
          >
            <div class="flex-1 pr-4">
              <div class="flex items-start space-x-3">
                <span class="text-primary font-medium text-[12px] leading-none mt-1">{index + 1}</span>
                <div class="flex-1">
                  <h5 class="text-foreground font-medium text-[14px] leading-tight mb-2 group-hover:text-primary transition-colors">
                    {article.title}
                  </h5>
                  <div class="flex items-center text-xs text-muted-foreground">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{formatDate(article.created_at, locale)}</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex-shrink-0">
              <img
                src={article.img_url || "/placeholder.svg"}
                alt={article.title}
                class="w-16 h-16 rounded object-cover"
              />
            </div>
          </ArticleLink>
        </div>
      ))}
    </div>
    <!-- <a href="/news" class="w-full text-right text-primary text-sm font-medium mt-6 hover:text-primary/80 inline-block transition-colors">
      {t('common.moreFromNews')}
    </a> -->
  </div>
</div>