---
import { fetchHomePageData } from '@/api/articles'
import type { Locale } from '@/types'
import ArticleLink from '@/components/common/astro/ArticleLink.astro'
import { getLocaleFromPath } from '@/lib/utils'
import { t } from '@/lib/i18n'
import {formatDate} from '@/utils/util'

interface Props {
  locale?: Locale
}

// Get locale from props or extract from URL - 从props获取locale或从URL中提取
const { locale: propsLocale } = Astro.props as Props
const locale: Locale = propsLocale || getLocaleFromPath(Astro.url.pathname) as Locale

/**
 * Fetch home page data for the sidebar
 * Uses latest articles from the API
 */
const homeData = await fetchHomePageData()
const latestNews = homeData?.lastest || []

// Check if article is within 12 hours for time display
const isWithin12Hours = (createdAt: string) => {
  const now = new Date().getTime()
  const twelveHoursAgo = now - 12 * 60 * 60 * 1000
  const articleTime = new Date(createdAt).getTime()
  return articleTime >= twelveHoursAgo
}
---

<div class="space-y-6 px-6">
  <div>
    <h3 class="font-medium text-foreground mb-4">{t(locale, 'common.latest')}</h3>
    <div class="space-y-0">
      {latestNews.map((article, index) => (
        <div>
        <ArticleLink
          slug={article.slug}
          business={article.business_type_name.toLowerCase()}
          locale={locale}
          class="flex items-start space-x-3 py-3 group transition-colors"
        >
          {isWithin12Hours(article.created_at) && (
            <div class="flex items-center space-x-2 text-xs text-muted-foreground">
              <span>{formatDate(article.created_at, locale)}</span>
            </div>
          )}
          <h4 class="font-medium text-foreground text-sm mt-1 mb-2 leading-tight group-hover:text-primary transition-colors">{article.title}</h4>
         
        </ArticleLink>
         {index < latestNews.length - 1 && (
            <div class="border-b border-border"></div>
          )}
          </div>
      ))}
    </div>
  </div>
</div>