---
import type { Locale, HomeLatestArticle, HomeNewsArticle, HomeWhoToFollow, HomeTopic, HomeMostReadArticle } from '@/types'
import MainContent from '@/components/home/astro/MainContent.astro'
import RightSidebar from '@/components/home/astro/RightSidebar.astro'
import Sidebar from '@/components/home/astro/Sidebar.astro'
// import ToFollowList from '@/components/home/astro/ToFollowList.astro'
import NewsSection from '@/components/home/astro/NewsSection.astro';
import TrendingSection from '@/components/home/astro/TrendingSection.astro';
import ResearchSection from '@/components/home/astro/ResearchSection.astro';
import AuthMount from '@/components/common/react/AuthMount';
import {
  hasBottomHomeSections,
  hasItems,
  hasRightSidebarContent,
} from '@/components/home/home-section-visibility';
interface Props {
  locale: Locale
  latestNews?: HomeLatestArticle[]
  newsAll?: HomeNewsArticle[]
  whoToFollow?: HomeWhoToFollow[]
  topics?: HomeTopic[]
  mostRead?: HomeMostReadArticle[]
  news?: Array<{
    tag: string;
    data: HomeNewsArticle[];
  }>
  insights?: HomeNewsArticle[]
  research?: HomeNewsArticle[]
}

const { locale, latestNews = [], newsAll = [], whoToFollow = [], topics = [], mostRead = [], news = [], insights = [], research = [] } = Astro.props as Props
const hasMainContent = hasItems(newsAll)
const hasLatestSection = hasItems(latestNews)
const hasRightSidebar = hasRightSidebarContent(topics, mostRead)
const hasBottomSections = hasBottomHomeSections({ news, insights, research })
---

<!-- Mobile Layout - 100% accurate restoration for mobile UI -->
<div class="md:hidden">
  <!-- Mobile Main Content -->
  {hasMainContent && (
    <div class="px-4 py-4">
      <MainContent locale={locale} newsAll={newsAll} />
    </div>
  )}
  
  <!-- Mobile Sidebar Content -->
  {hasLatestSection && (
    <div class="py-4 border-t border-gray-200">
      <Sidebar locale={locale} latestNews={latestNews} />
    </div>
  )}
  
  <!-- Mobile Right Sidebar Content -->
  <div class="py-4 border-t border-gray-200">
    <!-- React mount point for Login (Mobile) -->
    <div id="login-root"></div>
    <!-- AuthMount for mobile login -->
    <AuthMount client:load />
    {hasRightSidebar && <RightSidebar locale={locale} topics={topics} mostRead={mostRead} />}
  </div>
  {hasBottomSections && (
    <div class="pb-4 border-t border-gray-200">
      <NewsSection locale={locale} articles={news} />
      <TrendingSection articles={insights} />
      <ResearchSection locale={locale} articles={research} />
    </div>
  )}
</div>
