---
import type { Locale } from '@/types'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'

interface Props {
  slug: string
  locale: Locale
  business: string
  userId?: string // User ID for regular user articles
  article?: any // Article object to extract user_id from author info
  children?: any
  class?: string
  onClick?: string
}

const { slug, locale, business, userId, article, class: className = '', onClick } = Astro.props

/**
 * Generate article URL with promote code from cookies (SSR-friendly)
 * This ensures the URL is generated correctly on the server side
 *
 * URL formats:
 * - Admin/System articles: /article/{business}/{slug}-{promoteCode}
 * - User articles: /{userId}/article/{business}/{slug}-{promoteCode}
 *   (userId is numeric, distinguishable from language codes)
 */
const getArticleUrl = (slug: string) => {
  // Get promote code from cookies (SSR-compatible) or use default
  const promoteCode = Astro.cookies.get(STORAGE_KEYS.PROMOTE_CODE)?.value || DEFAULT_PROMOTE_CODE
  const businessPath = business.toLowerCase()

  // Determine userId from multiple sources
  let finalUserId = userId

  // If article object is provided, extract userId from it
  if (!finalUserId && article) {
    // Check user_id field first
    if (article.user_id) {
      finalUserId = article.user_id
    }
    // If author.role is "Authors", use author.id as userId
    else if (article.author?.role === "Authors" && article.author?.id) {
      finalUserId = article.author.id
    }
  }

  // If userId exists, it's a regular user article (numeric ID)
  if (finalUserId) {
    return `/${finalUserId}/article/${businessPath}/${slug}-${promoteCode}`
  }

  // Otherwise, it's an admin/system article
  return `/article/${businessPath}/${slug}-${promoteCode}`
}

const articleUrl = getArticleUrl(slug)
---

<a
  href={articleUrl}
  class={`hover:text-primary transition-colors ${className}`}
  onclick={onClick}
  data-article-link="true"
  data-slug={slug}
  data-locale={locale}
  data-business={business.toLowerCase()}
  data-author-id={userId}
>
  <slot />
</a>
