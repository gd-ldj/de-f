---
import type { Locale, SourceLanguage } from '@/types'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'
import { buildArticleUrl } from '@/lib/language-utils'

interface Props {
  slug: string
  locale: Locale
  business: string
  userId?: string // User ID for regular user articles
  isPromoted?: boolean
  article?: any // Article object to extract user_id from author info
  children?: any
  class?: string
  onClick?: string
}

const { slug, locale, business, userId, isPromoted, article, class: className = '', onClick } = Astro.props

/**
 * Generate article URL with promote code from cookies (SSR-friendly)
 * This ensures the URL is generated correctly on the server side
 *
 * URL formats:
 * - Admin/System articles: /article/{business}/{slug}-{promoteCode}
 * - User articles: /{userId}/article/{business}/{slug}-{promoteCode}
 *   (userId is numeric, distinguishable from language codes)
 */
let finalUserId = userId
if (!finalUserId && article) {
  if (article.user_id) {
    finalUserId = article.user_id
  } else if (article.author?.id) {
    finalUserId = article.author.id
  }
}

const finalIsPromoted = isPromoted ?? article?.is_promoted ?? false
const articleUrl = buildArticleUrl({
  category: business.toLowerCase(),
  slug,
  sourceLanguage: locale as SourceLanguage,
  userId: finalUserId,
  isPromoted: finalIsPromoted,
  promoteCode: Astro.cookies.get(STORAGE_KEYS.PROMOTE_CODE)?.value || DEFAULT_PROMOTE_CODE,
})
---

<a
  href={articleUrl}
  class={`hover:text-primary transition-colors ${className}`}
  onclick={onClick}
  data-article-link="true"
  data-slug={slug}
  data-locale={locale}
  data-business={business.toLowerCase()}
  data-author-id={finalUserId || ''}
  data-is-promoted={String(finalIsPromoted)}
>
  <slot />
</a>
