---
import type { Locale } from '@/types'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'

interface Props {
  slug: string
  locale: Locale
  business: string
  userId?: string // User ID for regular user articles
  children?: any
  class?: string
  onClick?: string
}

const { slug, locale, business, userId, class: className = '', onClick } = Astro.props

/**
 * Generate article URL with promote code from cookies (SSR-friendly)
 * This ensures the URL is generated correctly on the server side
 *
 * URL formats:
 * - Admin/System articles: /article/{business}/{slug}-{promoteCode}
 * - User articles: /u/{userId}/article/{business}/{slug}-{promoteCode}
 */
const getArticleUrl = (slug: string) => {
  // Get promote code from cookies (SSR-compatible) or use default
  const promoteCode = Astro.cookies.get(STORAGE_KEYS.PROMOTE_CODE)?.value || DEFAULT_PROMOTE_CODE
  const businessPath = business.toLowerCase()

  // If userId exists, it's a regular user article
  if (userId) {
    return `/u/${userId}/article/${businessPath}/${slug}-${promoteCode}`
  }

  // Otherwise, it's an admin/system article
  return `/article/${businessPath}/${slug}-${promoteCode}`
}

const articleUrl = getArticleUrl(slug)
---

<a
  href={articleUrl}
  class={`hover:text-primary transition-colors ${className}`}
  onclick={onClick}
  data-article-link="true"
  data-slug={slug}
  data-locale={locale}
  data-business={business.toLowerCase()}
  data-author-id={userId}
>
  <slot />
</a>
