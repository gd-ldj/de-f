---
import type { Locale } from '../../../types/index.ts';
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'
import { placeholderImageUrl } from '@/config/assets'
import { getArticleBusinessPath, getDisplayTopics, getLocalizedCategoryLabel, getLocalizedSubcategoryLabel, getLocalizedTagLabel } from '@/utils/util'
import { buildArticleUrl, getSourceLanguageFromRequest } from '@/lib/language-utils'
import type { SourceLanguage } from '@/types'
import { createTranslator } from '@/lib/i18n'

export interface Props {
  article: any;
  locale: Locale;
  layout?: 'vertical' | 'horizontal';
  showAuthor?: boolean;
  showDescription?: boolean;
  showTags?: boolean;
  imageSize?: 'small' | 'medium' | 'large';
  className?: string;
}

const { 
  article, 
  locale, 
  layout = 'vertical',
  showAuthor = true,
  showDescription = true,
  showTags = true,
  imageSize = 'medium',
  className = ''
} = Astro.props;

const t = createTranslator(locale)

const sourceLanguage: SourceLanguage = getSourceLanguageFromRequest(Astro.request, Astro.url.hostname)
const promoteCode = Astro.cookies.get(STORAGE_KEYS.PROMOTE_CODE)?.value || DEFAULT_PROMOTE_CODE
const categoryLabel = getLocalizedCategoryLabel(article, sourceLanguage)
const subcategoryLabel = getLocalizedSubcategoryLabel(article, sourceLanguage)

/**
 * Format date based on locale
 * @param {string} dateString - ISO date string or formatted date
 * @param {Locale} locale - Current locale
 * @returns {string} Formatted date string
 */
function formatDate(dateString: string, locale: Locale): string {
  if (!dateString) return '';
  
  try {
    const date = new Date(dateString);
    if (isNaN(date.getTime())) {
      return dateString; // Return original if not a valid date
    }
    
    const options: Intl.DateTimeFormatOptions = {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    };
    
    return date.toLocaleDateString(locale === 'zh' ? 'zh-CN' : locale === 'ja' ? 'ja-JP' : 'en-US', options);
  } catch {
    return dateString;
  }
}

/**
 * Generate article URL based on article data and locale
 * @param {any} article - Article object
 * @param {Locale} locale - Current locale
 * @returns {string} Article URL
 *
 * URL formats:
 * - Admin/System articles: /article/{business}/{slug}-{promoteCode}
 * - User articles: /{userId}/article/{business}/{slug}-{promoteCode}
 *   (userId is numeric, distinguishable from language codes)
 */
function getArticleUrl(article: any, locale: Locale): string {
  if (article.url) return article.url;
  if (article.slug) {
    const businessSegment = getArticleBusinessPath(article);
    let userId = article.user_id;
    if (!userId && article.author?.id) {
      userId = article.author.id;
    }

    return buildArticleUrl({
      category: businessSegment,
      slug: article.slug,
      sourceLanguage: locale as SourceLanguage,
      userId,
      isPromoted: article.is_promoted ?? false,
      promoteCode,
    });
  }
  return '#';
}

// Determine image source and alt text
const imageUrl = article.image || article.img_url || placeholderImageUrl;
const imageAlt = article.title || 'Article image';

// Determine article URL
const articleUrl = getArticleUrl(article, locale);

// Determine description
const description = article.description || article.sub_title;

// Prefer the normalized author name; fall back to legacy flat field.
const author = article.author?.name || article.author_name;

// Determine tags (prefer topic_names, fallback to tags)
const tags = getDisplayTopics(article);

// Check if this is a podcast article
const isPodcast = article.business_type_name === 'Podcasts';

// Image size classes
const imageSizeClasses = {
  small: layout === 'horizontal' ? 'w-20 h-16' : 'w-full h-32',
  medium: layout === 'horizontal' ? 'w-30 h-20' : 'w-full h-48',
  large: layout === 'horizontal' ? 'w-40 h-28' : 'w-full h-64'
};

const imageClasses = imageSizeClasses[imageSize];
---

{layout === 'vertical' ? (
  <!-- Vertical Card Layout -->
  <div class={`article-card-vertical space-y-2 ${className}`}>
    <!-- Article Image -->
    <a href={articleUrl} class="block relative w-full rounded overflow-hidden group">
      <img
        src={imageUrl}
        alt={imageAlt}
        class={`${imageClasses} object-cover group-hover:opacity-90 transition-opacity cursor-pointer`}
        loading="lazy"
      />
      {isPodcast && (
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 67 60" fill="#FF0000" class="w-12 h-12 drop-shadow-lg opacity-90 group-hover:opacity-100 transition-opacity" focusable="false" aria-hidden="true">
            <path d="M63 14.87a7.885 7.885 0 00-5.56-5.56C52.54 8 32.88 8 32.88 8S13.23 8 8.32 9.31c-2.7.72-4.83 2.85-5.56 5.56C1.45 19.77 1.45 30 1.45 30s0 10.23 1.31 15.13c.72 2.7 2.85 4.83 5.56 5.56C13.23 52 32.88 52 32.88 52s19.66 0 24.56-1.31c2.7-.72 4.83-2.85 5.56-5.56C64.31 40.23 64.31 30 64.31 30s0-10.23-1.31-15.13z"></path>
            <path fill="#FFF" d="M26.6 39.43L42.93 30 26.6 20.57z"></path>
          </svg>
        </div>
      )}
    </a>

    <!-- Categories -->
    {categoryLabel && (
      <div class="space-x-2 mt-4 line-clamp-1">
         <span class="text-xs font-medium text-primary uppercase tracking-wide">
            {categoryLabel}
          </span>
          {subcategoryLabel && <span class="text-xs font-medium text-primary uppercase tracking-wide">{subcategoryLabel}</span>}
        <!-- Tags -->
          {showTags && tags.length > 0 &&
            tags.map((tag: string) => (
              <span class="text-muted-foreground text-[10px] md:text-xs uppercase">
                {getLocalizedTagLabel(tag, sourceLanguage)}
              </span>
            ))
          }
      </div>
    )}

    <!-- Article Title -->
    <h4 class="text-lg font-medium text-foreground leading-tight">
      <a href={articleUrl} class="hover:text-primary transition-colors cursor-pointer line-clamp-2">
        {article.title}
      </a>
    </h4>

    <!-- Article Description -->
    {showDescription && description && (
      <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3">
        {description}
      </p>
    )}

    <!-- Author and Date -->
    <div class="flex items-center justify-start text-xs text-muted-foreground space-x-1">
      {article.created_at && (
        <span>{formatDate(article.created_at, locale)}</span>
      )}
      {showAuthor && author && (
        <p class="font-medium text-foreground space-x-1">
          <span class="text-muted-foreground ">/ {t('article.by')}</span>
          <span class="text-foreground uppercase">{author}</span>
        </p>
      )}
    </div>

    
  </div>
) : (
  <!-- Horizontal List Layout -->
  <article class={`article-card-horizontal flex space-x-4 py-6 border-b border-border last:border-b-0 ${className}`}>
    <!-- Article Image -->
    <div class="flex-shrink-0">
      <a href={articleUrl} class="relative block group">
        <img
          src={imageUrl}
          alt={imageAlt}
          class={`${imageClasses} object-cover rounded-lg border border-gray-200`}
          loading="lazy"
        />
        {isPodcast && (
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 67 60" fill="#FF0000" class="w-8 h-8 drop-shadow-lg opacity-90 group-hover:opacity-100 transition-opacity" focusable="false" aria-hidden="true">
              <path d="M63 14.87a7.885 7.885 0 00-5.56-5.56C52.54 8 32.88 8 32.88 8S13.23 8 8.32 9.31c-2.7.72-4.83 2.85-5.56 5.56C1.45 19.77 1.45 30 1.45 30s0 10.23 1.31 15.13c.72 2.7 2.85 4.83 5.56 5.56C13.23 52 32.88 52 32.88 52s19.66 0 24.56-1.31c2.7-.72 4.83-2.85 5.56-5.56C64.31 40.23 64.31 30 64.31 30s0-10.23-1.31-15.13z"></path>
              <path fill="#FFF" d="M26.6 39.43L42.93 30 26.6 20.57z"></path>
            </svg>
          </div>
        )}
      </a>
    </div>

    <!-- Article Content -->
    <div class="flex-1 min-w-0">
      <!-- Category and Date -->
      <div class="flex items-center space-x-2 text-xs text-muted-foreground mb-2">
        {categoryLabel && (
          <span class="px-2 py-1 bg-secondary/50 rounded-full text-xs font-medium">
            {categoryLabel}
          </span>
        )}
        {subcategoryLabel && <span class="px-2 py-1 bg-secondary/50 rounded-full text-xs font-medium">{subcategoryLabel}</span>}
        {article.created_at && (
          <>
            <span>•</span>
            <time>{formatDate(article.created_at, locale)}</time>
          </>
        )}
      </div>

      <!-- Title -->
      <h3 class="text-lg font-semibold text-foreground mb-2 line-clamp-2 hover:text-primary transition-colors">
        <a href={articleUrl}>
          {article.title}
        </a>
      </h3>

      <!-- Description/Subtitle -->
      {showDescription && description && (
        <p class="text-sm text-muted-foreground line-clamp-2 mb-3">
          {description}
        </p>
      )}

      <!-- Author -->
      {showAuthor && author && (
        <div class="text-xs text-muted-foreground mb-2">
          <span class="text-muted-foreground">{t('article.by')}</span>
          <span class="text-foreground uppercase ml-1">{author}</span>
        </div>
      )}

      <!-- Tags -->
      {showTags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {tags.slice(0, 3).map((tag: string) => (
            <span class="inline-block px-2 py-1 text-xs bg-gray-100 text-gray-700 rounded-md">
              {getLocalizedTagLabel(tag, sourceLanguage)}
            </span>
          ))}
          {tags.length > 3 && (
            <span class="text-xs text-muted-foreground">+{tags.length - 3}{t('common.more')}</span>
          )}
        </div>
      )}
    </div>
  </article>
)}

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
