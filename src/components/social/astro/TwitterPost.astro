---
interface Props {
  avatar?: string
  username?: string
  handle?: string
  timeAgo?: string
  content?: string
  images?: Array<{
    url: string
    alt: string
    brand?: string
  }>
  likes?: number
  views?: number
  showMoreReplies?: boolean
}

const { 
  avatar = "https://pbs.twimg.com/profile_images/1234567890/crypto_feed_news_400x400.jpg",
  username = "Crypto Feed News",
  handle = "@CryptoFeedNews", 
  timeAgo = "22h",
  content = "Massive Bitcoin ETF Move! 📊\n\nOn April 22, US spot Bitcoin ETFs scooped up 10,430 SBTC worth equivalent to $912.7 million.\nThat's the biggest single-day inflow since Trump's first inauguration. Institutional interest is heating up again, and the smart money seems to be positioning.\n\nAre we on the edge of another leg up? 🚀",
  images = [
    { url: "https://via.placeholder.com/400x200/ff6b9d/ffffff?text=PancakeSwap", alt: "PancakeSwap", brand: "PancakeSwap" },
    { url: "https://via.placeholder.com/400x200/1a1a1a/ffffff?text=Ethereum", alt: "Ethereum", brand: "Ethereum" },
    { url: "https://via.placeholder.com/400x200/2d5aa0/ffffff?text=Blockchain", alt: "Blockchain", brand: "Blockchain" },
    { url: "https://via.placeholder.com/400x200/9333ea/ffffff?text=MAO", alt: "MAO", brand: "MAO" }
  ],
  likes = 8181,
  views = 8181,
  showMoreReplies = true
} = Astro.props as Props
---

<article class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-lg transition-shadow duration-200">
  <!-- Tweet Header -->
  <div class="flex items-start gap-3 mb-3">
    <!-- User Avatar -->
    <div class="flex-shrink-0">
      <img 
        src={avatar} 
        alt={`${username} avatar`}
        class="w-10 h-10 rounded-full border border-gray-200"
      />
    </div>
    
    <!-- User Info and Content -->
    <div class="flex-1 min-w-0">
      <!-- Username and Handle -->
      <div class="flex items-center gap-2 mb-1">
        <h3 class="font-semibold text-gray-900 text-sm truncate">
          {username}
        </h3>
        <span class="text-gray-500 text-sm truncate">
          {handle}
        </span>
        <span class="text-gray-500 text-sm">·</span>
        <span class="text-gray-500 text-sm">
          {timeAgo}
        </span>
        <div class="ml-auto">
          <button class="text-gray-400 hover:text-gray-600 p-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 12h.01M12 12h.01M18 12h.01"/>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Tweet Content -->
      <div class="mb-3">
        <p class="text-gray-900 text-sm leading-relaxed whitespace-pre-line">
          {content}
        </p>
      </div>
      
      <!-- Images Grid -->
      {images && images.length > 0 && (
        <div class="mb-3">
          <div class="grid grid-cols-2 gap-2 rounded-xl overflow-hidden">
            {images.map((image, index) => (
              <div class="relative aspect-[4/3] bg-gray-100">
                <img 
                  src={image.url}
                  alt={image.alt}
                  class="w-full h-full object-cover hover:opacity-90 transition-opacity cursor-pointer"
                />
                {image.brand && (
                  <div class="absolute bottom-2 right-2">
                    <span class="bg-black bg-opacity-75 text-white text-xs px-2 py-1 rounded">
                      {image.brand}
                    </span>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
      
      <!-- Engagement Stats -->
      <div class="flex items-center gap-6 text-gray-500 text-sm">
        <!-- Comments -->
        <button class="flex items-center gap-1 hover:text-blue-600 transition-colors group">
          <svg class="w-4 h-4 group-hover:bg-blue-100 rounded-full p-0.5 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </button>
        
        <!-- Retweets -->
        <button class="flex items-center gap-1 hover:text-green-600 transition-colors group">
          <svg class="w-4 h-4 group-hover:bg-green-100 rounded-full p-0.5 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </button>
        
        <!-- Likes -->
        <button class="flex items-center gap-1 hover:text-red-600 transition-colors group">
          <svg class="w-4 h-4 group-hover:bg-red-100 rounded-full p-0.5 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <span>{likes?.toLocaleString()}</span>
        </button>
        
        <!-- Views -->
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <span>Views {views?.toLocaleString()}</span>
        </div>
        
        <!-- Share -->
        <button class="flex items-center gap-1 hover:text-blue-600 transition-colors group ml-auto">
          <svg class="w-4 h-4 group-hover:bg-blue-100 rounded-full p-0.5 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Show more replies option -->
  {showMoreReplies && (
    <div class="mt-3 pt-3 border-t border-gray-100">
      <button class="text-blue-600 text-sm hover:underline">
        Show more replies
      </button>
    </div>
  )}
</article>

<style>
  /* Custom hover effects */
  article:hover {
    transform: translateY(-1px);
  }
  
  /* Smooth transitions for interactive elements */
  button {
    transition: all 0.2s ease-in-out;
  }
  
  button:hover svg {
    transform: scale(1.1);
  }
  
  /* Image hover effects */
  img:hover {
    transform: scale(1.02);
  }
</style>