---
import { fetchArticles, fetchRecommendedArticles } from '../../../api/articles';
import type { ApiArticle, Locale } from '../../../types';
import { createTranslator } from '@/lib/i18n';
import { formatDate, getArticleBusinessPath } from '@/utils/util';
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants';

interface Props {
  locale: Locale;
  currentEntryId?: string;
  limit?: number;
}

const { locale, currentEntryId, limit = 2 } = Astro.props as Props;
const t = createTranslator(locale);

/**
 * Fetch research articles from API with fallback
 */
let articles: ApiArticle[] = [];

if (currentEntryId) {
  const recommendedArticles = await fetchRecommendedArticles(currentEntryId, limit);
  if (recommendedArticles && recommendedArticles.length > 0) {
    articles = recommendedArticles.filter((article) => article.entry_id !== currentEntryId);
  }
}

if (articles.length === 0) {
  const fetchLimit = currentEntryId ? limit * 2 : limit;

  try {
    const data = await fetchArticles(locale, 1, fetchLimit, {
      business_type_name: 'Research',
      order_by: 'Latest',
    });

    if (data && data.articles && data.articles.length > 0) {
      articles = data.articles;
    } else {
      throw new Error('No research articles found');
    }
  } catch (err) {
    console.error('Failed to fetch research data:', err);
  }
}

if (currentEntryId) {
  articles = articles.filter((article) => article.entry_id !== currentEntryId);
}

articles = articles.slice(0, limit);

const getMetaLabel = (article: ApiArticle) => {
  if (article.tags?.[0]) return article.tags[0];
  if (article.subcategory_names?.[0]) return article.subcategory_names[0];
  if (article.category_names?.[0]) return article.category_names[0];
  return article.business_type_name || 'Research';
};

const promoteCode = Astro.cookies.get(STORAGE_KEYS.PROMOTE_CODE)?.value || DEFAULT_PROMOTE_CODE;

const getArticleUrl = (article: ApiArticle) => {
  const businessSegment = getArticleBusinessPath(article);
  let userId = article.user_id;

  if (!userId && article.author?.role === 'Authors' && article.author?.id) {
    userId = article.author.id;
  }

  if (userId) {
    return `/${userId}/article/${businessSegment}/${article.slug}-${promoteCode}`;
  }

  return `/article/${businessSegment}/${article.slug}-${promoteCode}`;
};

---
{articles.length > 0 && (
  <section class="border-t border-border pt-6" data-testid="recent-research">
    <div class="mb-5">
      <h3 class="text-[28px] leading-[1.1] md:text-[30px] font-medium text-foreground">
        {t('common.recentResearch')}
      </h3>
    </div>

    <div class="space-y-3">
      {articles.map((article, index) => (
        <a
          href={getArticleUrl(article)}
          class="group block rounded-lg border border-border bg-background p-3 transition-colors duration-200 hover:bg-accent"
        >
          <article class="grid grid-cols-[88px_minmax(0,1fr)] gap-3 md:grid-cols-[104px_minmax(0,1fr)]" data-testid={`recent-research-item-${index + 1}`}>
            <div class="relative overflow-hidden rounded-md bg-secondary">
              <img
                src={article.img_url || '/placeholder.svg'}
                alt={article.title}
                class="h-[88px] w-full object-cover transition-transform duration-300 group-hover:scale-105 md:h-[104px]"
                loading="lazy"
              />
            </div>

            <div class="min-w-0">
              <div class="mb-2 flex items-center gap-2">
                <span class="inline-flex rounded-full bg-primary/10 px-2 py-1 text-[11px] leading-none text-primary">
                  {getMetaLabel(article)}
                </span>
                <span class="text-[11px] text-muted-foreground">{formatDate(article.created_at, locale)}</span>
              </div>

              <h4 class="line-clamp-3 text-base leading-[1.35] text-foreground transition-colors duration-200 group-hover:text-primary">
                {article.title}
              </h4>

              <div class="mt-3 flex items-center justify-between gap-3 text-xs text-muted-foreground">
                <span class="truncate uppercase">{article.author?.name || article.author_name || 'DeTake'}</span>
                <span class="shrink-0 text-foreground/70">{index + 1 < 10 ? `0${index + 1}` : index + 1}</span>
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>
)}
