---
import type { Locale, ApiArticle } from '@/types'

interface Props {
  // ApiArticle: the raw article shape returned by backend API
  // Only includes fields used by this component to keep typing minimal
  article: ApiArticle
  locale: Locale
  category: string
  categoryDisplayName: string
}

const { article, locale, category, categoryDisplayName } = Astro.props
 /**
  * Format date to readable string for article display
  * @param dateString - ISO date string
  * @returns Formatted date string based on locale
  */
 const formatDate = (dateString: string) => {
   const date = new Date(dateString)
   return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
     year: 'numeric',
     month: 'long',
     day: 'numeric'
   })
 }
---
 
 <article class="bg-white">
   <!-- Article Header -->
   <header class="mb-8">
     <!-- Breadcrumb -->
     <nav class="flex items-center space-x-2 text-sm text-muted-foreground mb-6">
       <a href={`/${locale}`} class="hover:text-primary">Articles</a>
       <span>/</span>
       <a href={`/${locale}/${category.toLowerCase()}`} class="hover:text-primary">{categoryDisplayName}</a>
       <span>/</span>
       <!-- <span class="text-foreground">{article.title}</span> -->
       <a href={`/${locale}/category/${article.category_name.toLowerCase()}`} class="hover:text-primary">{article.category_name}</a>
     </nav>
 
     <!-- Title -->
     <h1 class="text-4xl font-medium tracking-tight text-foreground mb-6 leading-tight">
       {article.title}
     </h1>
 
     <!-- Excerpt -->
     <p class="text-xl text-muted-foreground mb-2 leading-relaxed">
       {article.sub_title}
     </p>
 
     <div class="flex items-center justify-between pb-8">
      <div class="">
          <!-- Tags -->
        {article.tags.length > 0 && (
          <div class="mb-2 pt-2">
            <div class="flex flex-wrap gap-2">
              {article.tags.map((tag) => (
                <a
                  href={`/${locale}/tag/${tag}`}
                  class="inline-flex items-center rounded-md bg-secondary px-3 py-1 text-sm font-medium text-secondary-foreground hover:bg-secondary/80 transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}
    
        <!-- Author and Date -->
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <time class="text-sm text-muted-foreground" datetime={article.created_at}>
              {formatDate(article.created_at)}
            </time>
            
            <p class="font-medium text-foreground">
              <span class="text-sm text-muted-foreground mr-[2px]"> / By</span>
              {article.author?.name || article.author_name}
            </p>
          </div>
          
          
        </div>
      </div>
      <!-- Reading Stats -->
      <div class="flex items-center space-x-6">
        <!-- View Count -->
        <div class="flex flex-col items-center space-x-1">
          <div class="text-[32px]">{article?.page_view || 0}</div>
            <div class="flex items-center space-x-1">
            <img src="/eyes.svg" alt="Views" class="w-4 h-4 text-muted-foreground" />
            <span class="text-sm text-muted-foreground">Views</span>
          </div>
        </div>

        <!-- Author Avatar -->
        <div class="flex flex-col items-center space-x-1">
          <div class="text-[32px]">{article?.unique_vistor || 0}</div>
          <div class="flex items-center space-x-1">
            <img src="/avatar_2.svg" alt="Author" class="w-4 h-4 text-muted-foreground" />
            <span class="text-sm text-muted-foreground">Holders</span>
          </div>
        </div>
      </div>
     </div>
   </header>
 
   <!-- Featured Image -->
   {article.img_url && (
     <div class="mb-8">
       <img
         src={article.img_url}
         alt={article.title}
         class="w-full h-auto rounded shadow-lg"
         loading="lazy"
       />
     </div>
   )}
 
   <!-- Article Content -->
   <div class="prose prose-lg max-w-none mb-12">
     <div set:html={article.body} />
   </div>
 
   <!-- Author Section -->
   <div id="author-section-root"></div>
  
 </article>
 
 <style>
   .prose {
     color: #374151;
   }
   .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
     color: #111827;
     font-weight: 600;
     margin-top: 2rem;
     margin-bottom: 1rem;
   }
   .prose h1 {
     font-size: 2.25rem;
     line-height: 2.5rem;
   }
   .prose h2 {
     font-size: 1.875rem;
     line-height: 2.25rem;
   }
   .prose h3 {
     font-size: 1.5rem;
     line-height: 2rem;
   }
   .prose p {
     margin-bottom: 1.5rem;
     line-height: 1.75;
   }
   .prose a {
     color: #0d9488;
     text-decoration: none;
   }
   .prose a:hover {
     text-decoration: underline;
   }
   .prose blockquote {
     border-left: 4px solid #0d9488;
     padding-left: 1.5rem;
     font-style: italic;
     color: #6b7280;
     margin: 2rem 0;
   }
   .prose code {
     background-color: #f3f4f6;
     padding: 0.25rem 0.5rem;
     border-radius: 0.375rem;
     font-size: 0.875rem;
     color: #dc2626;
   }
   .prose pre {
     background-color: #1f2937;
     color: #f9fafb;
     padding: 1.5rem;
     border-radius: 0.5rem;
     overflow-x: auto;
     margin: 2rem 0;
   }
   .prose pre code {
     background-color: transparent;
     padding: 0;
     color: inherit;
   }
   .prose ul, .prose ol {
     margin: 1.5rem 0;
     padding-left: 2rem;
   }
   .prose li {
     margin: 0.5rem 0;
   }
   .prose img {
     margin: 2rem 0;
     border-radius: 0.5rem;
   }
 </style>