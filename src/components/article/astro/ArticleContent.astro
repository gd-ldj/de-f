---
import type { Locale, ApiArticle } from '@/types'
import { createTranslator } from '@/lib/i18n'
import Image from '@/components/common/astro/ImageSSR.astro'
import {formatDate} from '@/utils/util'

interface Props {
  // ApiArticle: the raw article shape returned by backend API
  // Only includes fields used by this component to keep typing minimal
  article: ApiArticle
  locale: Locale
  category: string
  categoryDisplayName: string
}

const { article, locale, category, categoryDisplayName } = Astro.props

// Use custom translation function for server-side rendering
const t = createTranslator(locale)

---
 
 <article class="bg-white">
   <!-- Article Header -->
   <header class="mb-4">
     <!-- Breadcrumb -->
     <nav class="flex items-center space-x-2 text-sm text-muted-foreground mb-2">
       <a href={`/${locale}`} class="hover:text-primary">{t('article.articles')}</a>
       <span>/</span>
       <a href={`/${locale}/${category.toLowerCase()}`} class="hover:text-primary">{categoryDisplayName}</a>
       <span>/</span>
       <!-- <span class="text-foreground">{article.title}</span> -->
       <!-- <a href={`/${locale}/category/${article.category_name.toLowerCase()}`} class="hover:text-primary">{article.category_name}</a> -->
       <a href="javascript:;"  class="hover:text-primary">{article.category_name}</a>
     </nav>
      <!-- Title -->
     <h1 class="text-[32px] md:text-[48px] font-medium tracking-tight text-foreground mb-[10px] md:mb-4 leading-tight">
       {article.title}
     </h1>
 
     <!-- Author and Date - Mobile: above title, Desktop: below tags -->
     <div class="md:hidden mb-[10px] md:mb-4">
       <div class="flex items-center space-x-1">
         <time 
           class="text-[12px] text-muted-foreground" 
           datetime={article.created_at}
           data-date={article.created_at}
           data-locale={locale}
         >
           {formatDate(article.created_at, locale)}
         </time>
         
         <p class="text-[12px] font-medium text-foreground">
           <span class="text-muted-foreground mr-[2px]">/ {t('article.by')}</span>
           {article.author?.name || article.author_name}
         </p>
       </div>
     </div>

    
 
     <!-- Excerpt -->
     <p class="text-[14px] md:text-xl text-muted-foreground leading-relaxed mb-[10px] md:mb-4">
       {article.sub_title}
     </p>

      <!-- Tags - Mobile: below stats -->
     <div class="md:hidden flex justify-between items-center">
       {article.tags.length > 0 && (
         <div class="">
           <div class="flex flex-wrap gap-2">
             {article.tags.map((tag) => (
               <a
                //  href={`/${locale}/tag/${tag}`}
                 href="javascript:;"
                 class="inline-flex items-center rounded bg-secondary px-3 py-1 text-sm font-medium text-secondary-foreground hover:bg-secondary/80 transition-colors"
               >
                 {tag}
               </a>
             ))}
           </div>
         </div>
       )}
       <div class="flex items-center justify-center space-x-8 py-3">
         <!-- View Count -->
         <div class="flex items-center space-x-2">
           <img src="/eyes.svg" alt="Views" class="w-4 h-4 text-muted-foreground" />
           <span class="text-sm">{article?.page_view || 0} {t('article.views')}</span>
         </div>

         <!-- Holders -->
         <div class="flex items-center space-x-2">
           <img src="/avatar_2.svg" alt="Holders" class="w-4 h-4 text-muted-foreground" />
           <span class="text-sm">{article?.unique_vistor || 0} {t('article.holders')}</span>
         </div>
       </div>
     </div>
 
     <!-- Desktop Layout -->
     <div class="hidden md:flex items-center justify-between mb-1 pb-2">
      <div class="">
          <!-- Tags -->
        {article.tags.length > 0 && (
          <div class="mb-2 pt-2">
            <div class="flex flex-wrap gap-2">
              {article.tags.map((tag) => (
                <a
                  // href={`/${locale}/tag/${tag}`}
                  href="javascript:;"
                  class="inline-flex items-center rounded bg-secondary px-3 py-1 text-sm font-medium text-secondary-foreground hover:bg-secondary/80 transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>
        )}
    
        <!-- Author and Date - Desktop -->
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-1">
            <time 
              class="text-sm text-muted-foreground" 
              datetime={article.created_at}
              data-date={article.created_at}
              data-locale={locale}
            >
              {formatDate(article.created_at, locale)}
            </time>
            
            <p class="text-sm font-medium text-foreground">
              <span class="text-muted-foreground mr-[2px]">/ {t('article.by')}</span>
              {article.author?.name || article.author_name}
            </p>
          </div>
        </div>
      </div>
      <!-- Reading Stats - Desktop -->
      <div class="flex items-center space-x-6">
        <!-- View Count -->
        <div class="flex flex-col items-center space-x-1">
          <div class="text-[32px]">{article?.page_view || 0}</div>
            <div class="flex items-center space-x-1">
            <img src="/eyes.svg" alt="Views" class="w-4 h-4 text-muted-foreground" />
            <span class="text-sm text-muted-foreground">{t('article.views')}</span>
          </div>
        </div>

        <!-- Author Avatar -->
        <div class="flex flex-col items-center space-x-1">
          <div class="text-[32px]">{article?.unique_vistor || 0}</div>
          <div class="flex items-center space-x-1">
            <img src="/avatar_2.svg" alt="Author" class="w-4 h-4 text-muted-foreground" />
            <span class="text-sm text-muted-foreground">{t('article.holders')}</span>
          </div>
        </div>
      </div>
     </div>

     
   </header>
 
   <!-- Featured Image -->
   {article.img_url && (
     <div class="mb-5 md:mb-8">
       <Image
         src={article.img_url}
         alt={article.title}
         className="w-full h-auto rounded shadow-lg"
         loading="lazy"
       />
     </div>
   )}
 
   <!-- Article Content -->
   <div class="mb-5 md:mb-8">
     <div set:html={article.body} />
   </div>

   <div class="w-full border-t border-border"></div>
 
   <!-- Author Section -->
   <div id="author-section-root"></div>
  
 </article>
 
 <style>
   .prose {
     color: #374151;
   }
   .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
     color: #111827;
     font-weight: 600;
     margin-top: 2rem;
     margin-bottom: 1rem;
   }
   .prose h1 {
     font-size: 2.25rem;
     line-height: 2.5rem;
   }
   .prose h2 {
     font-size: 1.875rem;
     line-height: 2.25rem;
   }
   .prose h3 {
     font-size: 1.5rem;
     line-height: 2rem;
   }
   .prose p {
     margin-bottom: 1.5rem;
     line-height: 1.75;
   }
   .prose a {
     color: #0d9488;
     text-decoration: none;
   }
   .prose a:hover {
     text-decoration: underline;
   }
   .prose blockquote {
     border-left: 4px solid #0d9488;
     padding-left: 1.5rem;
     font-style: italic;
     color: #6b7280;
     margin: 2rem 0;
   }
   .prose code {
     background-color: #f3f4f6;
     padding: 0.25rem 0.5rem;
     border-radius: 0.375rem;
     font-size: 0.875rem;
     color: #dc2626;
   }
   .prose pre {
     background-color: #1f2937;
     color: #f9fafb;
     padding: 1.5rem;
     border-radius: 0.5rem;
     overflow-x: auto;
     margin: 2rem 0;
   }
   .prose pre code {
     background-color: transparent;
     padding: 0;
     color: inherit;
   }
   .prose ul, .prose ol {
     margin: 1.5rem 0;
     padding-left: 2rem;
   }
   .prose li {
     margin: 0.5rem 0;
   }
   .prose img {
     margin: 2rem 0;
     border-radius: 0.5rem;
   }
 </style>