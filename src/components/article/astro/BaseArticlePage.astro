---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount'
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro'
import ArticleContent from '@/components/article/astro/ArticleContent.astro'
import RecentResearch from '@/components/article/astro/RecentResearch.astro'
import { fetchArticle, fetchTranslatedArticle } from '@/api/articles'
import type { Locale } from '@/types'
import Footer from '@/components/common/react/footer/Index'
import { SITE_CONFIG } from '@/config/constants'

interface Props {
  locale: Locale
  category: string
  slug: string
  userId?: string
}

const { locale, category, slug, userId } = Astro.props as Props
const { url } = Astro

const validCategories = ['insights', 'news', 'research']
if (!validCategories.includes(category.toLowerCase())) {
  return Astro.redirect('/404')
}

let actualSlug = slug
let promoteCode = null as string | null

const slugParts = slug.split('-')
if (slugParts.length > 1) {
  const lastPart = slugParts[slugParts.length - 1]
  if (lastPart) {
    promoteCode = lastPart
    actualSlug = slugParts.slice(0, -1).join('-')
  }
}

const slugWithPromote = promoteCode ? `${actualSlug}-${promoteCode}` : actualSlug

type ArticleLanguageCode = 'en' | 'zh' | 'ar' | 'ru' | 'ja'
const rawLang = url.searchParams.get('lang')
const defaultLangForLocale: ArticleLanguageCode = locale === 'asia' ? 'zh' : 'en'
const pageLanguage: ArticleLanguageCode =
  rawLang === 'en' || rawLang === 'zh' || rawLang === 'ar' || rawLang === 'ru' || rawLang === 'ja'
    ? rawLang
    : defaultLangForLocale

const baseArticle = await fetchArticle(actualSlug, locale, category)

if (!baseArticle) {
  return Astro.redirect('/404')
}

const baseArticleLanguage: ArticleLanguageCode =
  baseArticle.language === 'en' || baseArticle.language === 'zh' || baseArticle.language === 'ar' || baseArticle.language === 'ru' || baseArticle.language === 'ja'
    ? baseArticle.language
    : 'en'

let article = baseArticle

if (pageLanguage !== baseArticleLanguage) {
  const translated = await fetchTranslatedArticle(baseArticle.entry_id, pageLanguage)
  if (translated) {
    article = {
      ...baseArticle,
      title: translated.title,
      sub_title: translated.sub_title,
      body: translated.body,
      language: translated.language,
    }
  }
}

const articleLang = pageLanguage

const categoryDisplayName = category ? `${category[0].toUpperCase()}${category.slice(1)}` : 'News'

const title = `${article.title} | ${categoryDisplayName} | deTake`
const description = article.sub_title
const pathPrefix = userId ? `/${locale}/${userId}/article/${category}/${actualSlug}` : `/${locale}/article/${category}/${actualSlug}`
const baseCanonicalUrl = `${SITE_CONFIG.SITE_URL}${pathPrefix}`
const canonicalUrl =
  rawLang === 'en' || rawLang === 'zh' || rawLang === 'ar' || rawLang === 'ru' || rawLang === 'ja'
    ? `${baseCanonicalUrl}?lang=${rawLang}`
    : baseCanonicalUrl

const ogImageParams = new URLSearchParams({
  title: article.title,
  description: article.sub_title,
  category: categoryDisplayName,
  author: article?.author?.name || article.author_name || 'DeTake',
})
const ogImageUrl = article.img_url
  ? article.img_url.startsWith('http')
    ? article.img_url
    : `${SITE_CONFIG.SITE_URL}${article.img_url}`
  : `${SITE_CONFIG.SITE_URL}/api/og/article.svg?${ogImageParams.toString()}`

const keywords = article.tags || []
const publishedTime = article.created_at
const modifiedTime = article.updated_at
const author = article?.author?.name || article.author_name
---

<BaseLayout 
  title={title} 
  description={description} 
  locale={locale} 
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={`${article.title} - ${categoryDisplayName} article on DeTake`}
  ogType="article"
  twitterCard="summary_large_image"
  author={author}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  keywords={keywords}
  articleSection={categoryDisplayName}
>
  <HeaderWithFallback locale={locale} />
  <AuthMount 
    client:load 
    userButtonTargetId="user-button-root"
    shareSection={{ locale, title: article.title, url: canonicalUrl }}
    authorSection={{
      author: {
        id: article?.author?.id,
        name: article?.author?.name || article.author_name || '',
        avatar: article?.author?.avatar_url,
        bio: article?.author?.bio,
        email: article?.contact?.email,
        twitter: article?.contact?.twitter,
      },
      locale
    }}
  />
  
  <main class="min-h-screen mt-[56px] md:mt-[97px]">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3">
        <div class="lg:col-span-2 pt-5 md:pt-8 md:py-5 px-4 md:px-6 border border-t-0 border-border">
          <ArticleContent 
            article={article} 
            locale={locale} 
            category={category} 
            categoryDisplayName={categoryDisplayName}
            slugWithPromote={slugWithPromote}
            articleLang={articleLang}
          />
        </div>
        
        <div class="lg:col-span-1 border border-t-0 border-l-0 border-border">
          <div class="top-8">
            <div id="share-section-root" class=""></div>
            <div class="px-6 p-5">
              <RecentResearch locale={locale} currentEntryId={article.entry_id} limit={4} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer client:load />
</BaseLayout>

