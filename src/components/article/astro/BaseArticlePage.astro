---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount'
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro'
import ArticleContent from '@/components/article/astro/ArticleContent.astro'
import RecentResearch from '@/components/article/astro/RecentResearch.astro'
import { fetchArticle, fetchTranslatedArticle } from '@/api/articles'
import type { Locale, SourceLanguage, TranslationLanguage } from '@/types'
import Footer from '@/components/common/react/footer/Index'
import { SITE_CONFIG } from '@/config/constants'
import { buildArticleUrl } from '@/lib/language-utils'
import { getArticleBusinessPath } from '@/utils/util'

interface Props {
  locale: Locale
  category: string
  slug: string
  userId?: string
  sourceLanguage: SourceLanguage
  translationLanguage: TranslationLanguage | null
}

const { locale, category, slug, userId, sourceLanguage, translationLanguage } = Astro.props as Props
const { url } = Astro

const validCategories = ['insights', 'news', 'research', 'voices']
if (!validCategories.includes(category.toLowerCase())) {
  return Astro.redirect('/404')
}

let actualSlug = slug
let promoteCode = null as string | null

const slugParts = slug.split('-')
if (slugParts.length > 1) {
  const lastPart = slugParts[slugParts.length - 1]
  if (lastPart) {
    promoteCode = lastPart
    actualSlug = slugParts.slice(0, -1).join('-')
  }
}

const slugWithPromote = promoteCode ? `${actualSlug}-${promoteCode}` : actualSlug

// Determine which language to display
// If translationLanguage is provided and different from source, fetch translation
const baseArticle = await fetchArticle(actualSlug, locale, category, userId)

if (!baseArticle) {
  return Astro.redirect('/404')
}

let article = baseArticle

// Fetch translation if needed
if ((translationLanguage && translationLanguage !== sourceLanguage) || (translationLanguage === null && sourceLanguage !== 'en')) {
  const translated = await fetchTranslatedArticle(baseArticle.entry_id, translationLanguage || sourceLanguage)
  if (translated) {
    article = {
      ...baseArticle,
      title: translated.title,
      sub_title: translated.sub_title,
      body: translated.body,
      language: translated.language,
    }
  }
}

// The effective language being displayed
const articleLang = translationLanguage || sourceLanguage

const categoryDisplayName = getArticleBusinessPath(article) || (category ? `${category[0].toUpperCase()}${category.slice(1)}` : 'News')

const title = `${article.title} | ${categoryDisplayName} | deTake`
const description = article.sub_title

// Build canonical URL using new multi-source architecture
// Use current origin instead of SITE_CONFIG.SITE_URL to support multiple domains
const articlePath = buildArticleUrl(category, actualSlug, sourceLanguage, translationLanguage, userId)
const canonicalUrl = `${url.origin}${articlePath}`

const ogImageParams = new URLSearchParams({
  title: article.title,
  description: article.sub_title,
  category: categoryDisplayName,
  author: article?.author?.name || article.author_name || 'DeTake',
})
const ogImageUrl = article.img_url
  ? article.img_url.startsWith('http')
    ? article.img_url
    : `${SITE_CONFIG.SITE_URL}${article.img_url}`
  : `${SITE_CONFIG.SITE_URL}/api/og/article.svg?${ogImageParams.toString()}`

const keywords = article.tags || []
const publishedTime = article.created_at
const modifiedTime = article.updated_at
const author = article?.author?.name || article.author_name

// Get available translations for hreflang
// TODO: Fetch actual available translations from API
// For now, assume all articles support these languages
const availableTranslations: TranslationLanguage[] = ['en', 'zh', 'ja', 'fr', 'ar', 'ru']
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={`${article.title} - ${categoryDisplayName} article on DeTake`}
  ogType="article"
  twitterCard="summary_large_image"
  author={author}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  keywords={keywords}
  articleSection={categoryDisplayName}
  pageLang={articleLang}
  sourceLanguage={sourceLanguage}
  translationLanguage={translationLanguage}
  availableTranslations={availableTranslations}
>
  <HeaderWithFallback locale={locale} />
  <AuthMount 
    client:load 
    shareSection={{ locale, title: article.title, url: canonicalUrl, articleId: article.entry_id }}
    authorSection={{
      author: {
        id: article?.author?.id,
        name: article?.author?.name || article.author_name || '',
        avatar: article?.author?.avatar_url,
        bio: article?.author?.bio,
        email: article?.contact?.email,
        twitter: article?.contact?.twitter,
      },
      locale
    }}
  />
  
  <!-- Inject article data for page_view analytics enrichment -->
  <script is:inline define:vars={{ articleId: article.entry_id, authorId: article.author?.id || '', promoteCode: promoteCode || '' }}>
    window.__ANALYTICS_PAGE_DATA = { articleId: articleId, authorId: authorId, promoteCode: promoteCode };
  </script>

  <main class="min-h-screen mt-[56px] md:mt-[97px]">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid layout-two-column-fixed-1440">
        <div class="pt-5 md:pt-8 md:py-5 px-4 md:px-6 border-r border-border">
          <ArticleContent 
            article={article} 
            locale={locale} 
            category={category} 
            categoryDisplayName={categoryDisplayName}
            slugWithPromote={slugWithPromote}
            articleLang={articleLang}
            userId={userId}
          />
        </div>
        
        <div class="">
          <div class="top-8">
            <div id="share-section-root" class=""></div>
            <div class="px-6 p-5">
              <RecentResearch locale={locale} currentEntryId={article.entry_id} limit={4} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer client:load locale={locale} />
</BaseLayout>
