---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro'
import AuthMount from '@/components/common/react/AuthMount'
import type { Locale, CollectionItem } from '@/types'
import Footer from '@/components/common/react/footer/Index'
import RecentResearch from '@/components/article/astro/RecentResearch.astro'
import { SITE_CONFIG } from '@/config/constants'
import { fetchCollections } from '@/api/collections'

export const prerender = false // Enable SSR for this page

const { locale } = Astro.params as { locale: Locale }

// Validate locale
const validLocales = ['us', 'asia']
if (!validLocales.includes(locale)) {
  return Astro.redirect('/404')
}

// SEO optimization
const title = locale === 'us' ? 'Collections | deTake' : '我的收藏 | deTake'
const description =
  locale === 'us'
    ? 'Discover curated collections of crypto insights, research and news on deTake.'
    : '在 deTake 浏览精心整理的加密洞察、研究与资讯收藏集。'
const canonicalUrl = `${SITE_CONFIG.SITE_URL}/${locale}/collections/my`

// Generate OG image
const ogImageParams = new URLSearchParams({
  title: title,
  description: description,
  type: 'website'
})
const ogImageUrl = `${SITE_CONFIG.SITE_URL}/api/og/collections.svg?${ogImageParams.toString()}`

// Extract keywords
const keywords = ['collections', 'favorites', 'crypto', 'blockchain', 'research', 'insights']

const cardBackgrounds = ['#F3F4F6', '#E7F7F2', '#FFEFE5', '#F0FFE5']

let collections: CollectionItem[] = []

try {
  const { items } = await fetchCollections(1, 10)
  collections = items
} catch (error) {
  console.error('Failed to fetch collections:', error)
}

---

<BaseLayout 
  title={title} 
  description={description} 
  locale={locale} 
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt="Learn cryptocurrency and blockchain terminology on DeTake"
  ogType="website"
  twitterCard="summary_large_image"
  keywords={keywords}
>
  <!-- React Header - Independent loading -->
  <HeaderWithFallback locale={locale} />
  <AuthMount client:load shareSection={{ locale, title, url: canonicalUrl }} />
  
  <main class="min-h-screen mt-[56px] md:mt-[97px]">


    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3">
        <!-- Left Column - Collections Content -->
        <div class="lg:col-span-2 pt-5 md:py-5 px-4 md:px-0 border border-t-0 border-border">
          <!-- Page Title -->
          <header class="md:px-6 mb-4 hidden md:block">
            <h1 class="text-[32px] md:text-[64px] font-both text-[#052019]">
              Collections
            </h1>
          </header>

          <!-- Collections List -->
          <section class="md:px-6 space-y-5 pb-6">
            {collections.map((item, index) => (
              <a
                href={`/${locale}/collections/${item.id}`}
                class="block rounded-[2px] border border-gray-200 overflow-hidden bg-transparent md:bg-white hover:shadow-md transition-shadow"
              >
                {/* Mobile layout */}
                <div
                  class="md:hidden"
                  style={`background-color: ${cardBackgrounds[index % cardBackgrounds.length]};`}
                >
                    <div class="rounded-[2px] overflow-hidden">
                      <div class="relative">
                        <img
                          src={item.image_url}
                          alt={item.name}
                          loading="lazy"
                          class="w-full h-[186px] object-cover"
                        />
                        <div class="absolute left-4 top-4 w-12 h-12 rounded-[2px] overflow-hidden bg-black/10 flex items-center justify-center">
                          <img
                            src={item.logo_url}
                            alt={item.name}
                            loading="lazy"
                            class="w-full h-full object-cover"
                          />
                        </div>
                        <div class="absolute right-4 top-4 h-6 px-2 rounded-[2px] bg-white/40 flex items-center gap-1">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#C0C4CC]"></span>
                          <span class="text-[10px] font-medium text-white">{item.views_count}</span>
                        </div>
                      </div>
                      <div class="px-4 pt-3 pb-4">
                        <h2 class="text-[15px] font-semibold leading-snug text-[#052019]">
                          {item.name}
                        </h2>
                        <p class="mt-2 text-[12px] leading-[18px] text-[#909399]">
                          {item.description}
                        </p>
                        <div class="mt-4 rounded-[2px] bg-white px-3 py-5 flex items-center gap-20">
                          <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-[2px] bg-[#121721] flex items-center justify-center overflow-hidden">
                              <img
                                src={item.logo_url}
                                alt={item.name}
                                loading="lazy"
                                class="w-full h-full object-cover"
                              />
                            </div>
                            <div>
                              <div class="text-[13px] font-semibold text-[#121721]">
                                {item.hunters_count}
                              </div>
                              <div class="mt-0.5 text-[11px] text-[#6E6F79]">
                                {locale === 'us' ? 'Hunters' : 'Hunters'}
                              </div>
                            </div>
                          </div>
                          <div class="flex items-center gap-3">
                            <div>
                              <div class="text-[13px] font-semibold text-[#121721]">
                                {item.bonus_amt}
                              </div>
                              <div class="mt-0.5 text-[11px] text-[#6E6F79]">
                                {locale === 'us' ? 'Bonus' : 'Bonus'}
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>

                {/* Desktop layout */}
                <div class="hidden md:flex md:flex-row">
                  <div class="flex-1 flex flex-col" style={`background-color: ${cardBackgrounds[index % cardBackgrounds.length]};`}>
                    <div class="px-4 md:px-6 pt-4 md:pt-5 pb-4 flex items-start justify-between">
                      <div class="flex flex-col gap-3">
                        <div class="w-10 h-10 rounded-[2px] overflow-hidden bg-black flex items-center justify-center">
                          <img
                            src={item.logo_url}
                            alt={item.name}
                            loading="lazy"
                            class="w-full h-full object-cover"
                          />
                        </div>
                        <div class="max-w-full">
                          <h2 class="text-base md:text-[24px] font-both text-[#052019]">
                            {item.name}
                          </h2>
                          <p class="text-xs md:text-sm text-gray-600 mt-[10px] whitespace-nowrap overflow-hidden text-ellipsis">
                            {item.description}
                          </p>
                        </div>
                      </div>
                      <div class="inline-flex items-center gap-1 px-2 py-1 rounded-[2px] bg-white/70  text-gray-600">
                        <span class="inline-block w-[18px] h-[18px] overflow-hidden">
                          <img
                            src="/avatar_3.svg"
                            alt="avatar"
                            loading="lazy"
                            class="w-full h-full object-cover"
                          />
                        </span>
                        <span>{item.views_count}</span>
                      </div>
                    </div>
                    <div class="px-4 md:px-6 py-4">
                      <div class="bg-white rounded-md px-4 py-3 flex items-center gap-10 text-xs text-gray-700">
                        <div class="flex items-center gap-3">
                          <div class="w-8 h-8 rounded-[2px] overflow-hidden">
                            <img
                              src="/collection-image.svg"
                              alt="collection"
                              loading="lazy"
                              class="w-full h-full object-cover"
                            />
                          </div>
                          <div>
                            <div class="text-sm font-semibold">{item.hunters_count}</div>
                            <div class="text-[11px] text-gray-500 mt-0.5">
                              {locale === 'us' ? 'Hunters' : 'Hunters'}
                            </div>
                          </div>
                        </div>
                        <div class="flex items-center gap-3">
                          <div>
                            <div class="text-sm font-semibold">{item.bonus_amt}</div>
                            <div class="text-[11px] text-gray-500 mt-0.5">
                              {locale === 'us' ? 'Bonus' : 'Bonus'}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="flex-1 w-full md:w-[476px] h-[260px] bg-black relative">
                    <img
                      src={item.image_url}
                      alt={item.name}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                </div>
              </a>
            ))}
          </section>
        </div>
        
        <!-- Right Column - Sidebar Content -->
        <div class="lg:col-span-1 border border-t-0 border-l-0 border-border">
          <div class="sticky top-8">
            <div id="share-section-root" class=""></div>
            <div class="px-6 p-5">
              <RecentResearch locale={locale} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <!-- Footer -->
  <Footer client:load />

</BaseLayout>
