---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro'
import AuthMount from '@/components/common/react/AuthMount'
import type { Locale, CollectionItem } from '@/types'
import Footer from '@/components/common/react/footer/Index'
import RecentResearch from '@/components/article/astro/RecentResearch.astro'
import { SITE_CONFIG } from '@/config/constants'
import { fetchCollections } from '@/api/collections'
import { createTranslator } from '@/lib/i18n'

export const prerender = false // Enable SSR for this page

const { locale } = Astro.params as { locale: Locale }

// Validate locale
const validLocales = ['us', 'asia']
if (!validLocales.includes(locale)) {
  return Astro.redirect('/404')
}

// SEO optimization
const t = createTranslator(locale)
const title = t('pages.collectionsTitle')
const description = t('pages.collectionsDescription')
const canonicalUrl = `${SITE_CONFIG.SITE_URL}/${locale}/collections?mask=detake`

// Generate OG image
const ogImageParams = new URLSearchParams({
  title: title,
  description: description,
  type: 'website'
})
const ogImageUrl = `${SITE_CONFIG.SITE_URL}/api/og/collections.svg?${ogImageParams.toString()}`

// Extract keywords
const keywords = ['collections', 'favorites', 'crypto', 'blockchain', 'research', 'insights']

const cardBackgrounds = ['#F3F4F6', '#E7F7F2', '#FFEFE5', '#F0FFE5']

let collections: CollectionItem[] = []

try {
  const { items } = await fetchCollections(1, 10)
  collections = items
} catch (error) {
  console.error('Failed to fetch collections:', error)
}

---

<BaseLayout 
  title={title} 
  description={description} 
  locale={locale} 
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt="Learn cryptocurrency and blockchain terminology on DeTake"
  ogType="website"
  twitterCard="summary_large_image"
  keywords={keywords}
>
  <!-- React Header - Independent loading -->
  <HeaderWithFallback locale={locale} />
  <AuthMount client:load shareSection={{ locale, title, url: canonicalUrl }} />
  
  <main class="min-h-screen mt-[56px] md:mt-[97px]">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid layout-two-column-fixed-1440">
        <!-- Left Column - Collections Content -->
        <div class="pt-5 md:py-5 px-4 md:px-0 border border-t-0 border-border">
          <!-- Page Title -->
          <header class="md:px-6 mb-4 hidden md:block">
            <h1 class="text-[32px] md:text-[56px] font-medium text-[#052019]">
              {t('navigation.collections')}
            </h1>
          </header>

          <!-- Collections List -->
          <section class="md:px-6 space-y-5 pb-6">
            {collections.map((item, index) => (
              <a
                href={`/${locale}/collections/${item.id}`}
                class="block rounded-[2px] border border-gray-200 overflow-hidden bg-transparent md:bg-white hover:shadow-md transition-shadow"
              >
                {/* Mobile layout */}
                <div
                  class="md:hidden"
                  style={`background-color: ${cardBackgrounds[index % cardBackgrounds.length]};`}
                >
                    <div class="rounded-[2px] overflow-hidden">
                      <div class="relative">
                        <img
                          src={item.image_url}
                          alt={item.name}
                          loading="lazy"
                          class="w-full h-[186px] object-cover"
                        />
                        <div class="absolute left-4 top-4 w-12 h-12 rounded-[2px] overflow-hidden bg-black/10 flex items-center justify-center">
                          <img
                            src={item.logo_url}
                            alt={item.name}
                            loading="lazy"
                            class="w-full h-full object-cover"
                          />
                        </div>
                        <div class="absolute right-4 top-4 h-6 px-2 rounded-[2px] bg-white/40 flex items-center gap-1 text-[12px]">
                         <span class="inline-block w-[14px] h-[14px] overflow-hidden">
                          <img
                            src="/avatar_3.svg"
                            alt="avatar"
                            loading="lazy"
                            class="w-[full] h-full object-cover"
                          />
                          </span>
                          <span>{item.views_count}</span>
                        </div>
                      </div>
                      <div class="p-4">
                        <div class="flex flex-col justify-between h-full mb-4">
                          <h2 class="text-[20px] font-medium leading-snug text-[#052019] line-clamp-1">
                            {item.name}
                          </h2>
                          <p class="mt-[10px] text-[14px] leading-[18px] text-[#909399] line-clamp-2">
                            {item.description}
                          </p>
                         </div>
                        <div class="rounded-[2px] bg-white p-3 flex items-center gap-24">
                          <div class="flex items-center gap-3">
                            <div class="w-[26px] h-[26px] rounded-[2px] flex items-center justify-center overflow-hidden">
                              <img
                                src={item.logo_url}
                                alt={item.name}
                                loading="lazy"
                                class="w-full h-full object-cover"
                              />
                            </div>
                            <div>
                              <div class="text-[16px] font-medium text-[#121721]">
                                {item.hunters_count}
                              </div>
                              <div class="text-[12px] text-[#6E6F79]">
                                {t('collections.hunters')}
                              </div>
                            </div>
                          </div>
                          <div class="flex items-center gap-3">
                            <div>
                              <div class="text-[16px] font-medium text-[#121721]">
                                {item.bonus_amt}
                              </div>
                              <div class="text-[12px] text-[#6E6F79]">
                                {t('collections.bonus')}
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>

                {/* Desktop layout */}
                <div class="hidden md:flex md:flex-row h-[260px]">
                  <div class="flex-1 flex flex-col" style={`background-color: ${cardBackgrounds[index % cardBackgrounds.length]};`}>
                    <div class="px-4 md:px-5 pt-4 md:pt-5 pb-4 flex items-start justify-between">
                      <div class="flex flex-col gap-4">
                        <div class="w-10 h-10 rounded-[2px] overflow-hidden bg-black flex items-center justify-center">
                          <img
                            src={item.logo_url}
                            alt={item.name}
                            loading="lazy"
                            class="w-full h-full object-cover"
                          />
                        </div>
                        <div class="max-w-full">
                          <h2 class="text-base md:text-[24px] font-medium text-[#052019] line-clamp-1">
                            {item.name}
                          </h2>
                          <p class="text-xs md:text-sm text-gray-600 mt-[10px] line-clamp-2">
                            {item.description}
                          </p>
                        </div>
                      </div>
                      <div class="inline-flex items-center gap-1 px-2 py-1 rounded-[2px] bg-white/70  text-gray-600 text-[12px]">
                        <span class="inline-block w-[14px] h-[14px] overflow-hidden">
                          <img
                            src="/avatar_3.svg"
                            alt="avatar"
                            loading="lazy"
                            class="w-[full] h-full object-cover"
                          />
                        </span>
                        <span>{item.views_count}</span>
                      </div>
                    </div>
                    <div class="px-4 md:px-5 pb-4 mt-auto">
                      <div class="bg-white rounded-[2px] p-3 flex items-center gap-24 text-xs text-gray-700">
                        <div class="flex items-center gap-3">
                          <div class="w-[26px] h-[26px] rounded-[2px] overflow-hidden">
                            <img
                              src="/collection-image.svg"
                              alt="collection"
                              loading="lazy"
                              class="w-full h-full object-cover"
                            />
                          </div>
                          <div>
                            <div class="text-[16px] font-medium">{item.hunters_count}</div>
                            <div class="text-[12px] text-[#6E6F79]">
                                {t('collections.hunters')}
                            </div>
                          </div>
                        </div>
                        <div class="flex items-center gap-3">
                          <div>
                            <div class="text-[16px] font-medium">{item.bonus_amt}</div>
                            <div class="text-[12px] text-[#6E6F79]">
                              {t('collections.bonus')}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="md:w-[476px] h-[260px] bg-black relative flex-shrink-0">
                    <img
                      src={item.image_url}
                      alt={item.name}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                </div>
              </a>
            ))}
          </section>
        </div>
        
        <!-- Right Column - Sidebar Content -->
        <div class="border border-t-0 border-l-0 border-border">
          <div class="sticky top-8">
            <div id="share-section-root" class=""></div>
            <div class="px-6 p-5">
              <RecentResearch locale={locale} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <!-- Footer -->
  <Footer client:load />

</BaseLayout>
