---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro'
import AuthMount from '@/components/common/react/AuthMount'
import type { Locale, ApiArticle } from '@/types'
import Footer from '@/components/common/react/footer/Index'
import { createTranslator } from '@/lib/i18n'
import RecentResearch from '@/components/article/astro/RecentResearch.astro'
import { SITE_CONFIG } from '@/config/constants'
import { fetchCollectionArticles, fetchCollections } from '@/api/collections'
import { formatDate } from '@/utils/util'
import CollectionArticlesList from '@/components/collections/CollectionArticlesList'

const { locale, slug } = Astro.params as { locale: Locale; slug: string }

const validLocales = ['us', 'asia']
if (!validLocales.includes(locale)) {
  return Astro.redirect('/404')
}

const t = createTranslator(locale)

// 从接口获取合集元信息（名称、描述等），避免写死
const resolveCollectionItem = async (id: string) => {
  try {
    const { items } = await fetchCollections(1, 100)
    const found = items.find((item) => item.id === id)
    if (found) {
      return {
        title: found.name,
        description: found.description,
        logo_url: found.logo_url,
        image_url: found.image_url,
      }
    }
  } catch (error) {
    console.error('Failed to fetch collection item:', error)
  }
  // Fallback：用 slug 兜底标题，描述为空
  const fallbackTitle = slug
    .split('-')
    .map((w) => (w.toLowerCase() === 'ai' ? 'AI' : w.charAt(0).toUpperCase() + w.slice(1)))
    .join(' ')
  return {
    title: fallbackTitle,
    description: '',
  }
}

const collectionItem = await resolveCollectionItem(slug)

let collectionArticles: ApiArticle[] = []
let collectionHasMore = false
try {
  const data = await fetchCollectionArticles(locale, slug, 1, 11)
  collectionArticles = data.articles || []
  collectionHasMore = data.hasMore
} catch (error) {
  console.error('Failed to fetch collection articles:', error)
}

const title = `${collectionItem.title} | Collections | deTake`
const description = collectionItem.description
const canonicalUrl = `${SITE_CONFIG.SITE_URL}/${locale}/collections/${slug}?mask=detake`

const ogImageParams = new URLSearchParams({
  title: collectionItem.title,
  description,
  type: 'collection'
})
const ogImageUrl = `${SITE_CONFIG.SITE_URL}/api/og/collections.svg?${ogImageParams.toString()}`

const keywords = ['collections', 'favorites', 'crypto', 'blockchain', collectionItem.title.toLowerCase()]

export const prerender = false

---

<BaseLayout 
  title={title} 
  description={description} 
  locale={locale} 
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={`Learn about ${collectionItem.title} on DeTake`}
  ogType="article"
  twitterCard="summary_large_image"
  keywords={keywords}
>
  <!-- React Header - Independent loading -->
  <HeaderWithFallback locale={locale} />
  <AuthMount client:load shareSection={{ locale, title: collectionItem.title, url: canonicalUrl }} />
  
  <main class="min-h-screen mt-[56px] md:mt-[97px]">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3">
        <!-- Left Column - Learn Content (SSR/ISR for SEO) -->
        <div class="lg:col-span-2 pt-5 md:pt-8 md:py-5 border border-t-0 border-border">
          <div class="mb-6 pb-5 px-4 md:px-6 border-b border-border">
            <div class="mb-3 text-sm text-muted-foreground">
              <a href={`/${locale}/collections`} class="hover:text-primary">
                Collections
              </a>
              <span class="mx-1">/</span>
              <span class="text-primary">
                {collectionItem.title}
              </span>
            </div>
            <h1 class="text-[48px] font-medium tracking-tight text-foreground mb-2 leading-tight">
              {collectionItem.title}
            </h1>
            {collectionItem.description && (
              <p class="text-sm md:text-[20px] text-muted-foreground max-w-3xl">
                {collectionItem.description}
              </p>
            )}
          </div>

          <CollectionArticlesList
            client:load
            locale={locale}
            collectionId={slug}
            initialArticles={collectionArticles}
            hasMore={collectionHasMore}
          />
        </div>
        
        <!-- Right Column - Data Display (React Components) -->
        <div class="lg:col-span-1 border border-t-0 border-l-0 border-border">
          <div class="top-8">
            <!-- Share Section mount: rendered via AuthMount under PrivyProvider -->
            <div id="share-section-root" class=""></div>
            <!-- <ArticleSidebar locale={locale} client:load /> -->
            <div class="px-6 p-5">
              <RecentResearch locale={locale} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <!-- Footer -->
  <Footer client:load />
</BaseLayout>
