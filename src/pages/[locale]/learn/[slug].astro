---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro'
import { fetchLearnItem } from '@/api/learn'
import type { Locale } from '@/types'
import Footer from '@/components/common/react/footer/Index'
import { createTranslator } from '@/lib/i18n'
import RecentResearch from '@/components/article/astro/RecentResearch.astro'
import { SITE_CONFIG } from '@/config/constants'
export const prerender = false // Enable SSR for this page

const { locale, slug } = Astro.params as { locale: Locale; slug: string }

// Validate locale
const validLocales = ['us', 'asia']
if (!validLocales.includes(locale)) {
  return Astro.redirect('/404')
}

const t = createTranslator(locale)

// Fetch learn item
let learnItem = null
try {
  learnItem = await fetchLearnItem(locale, slug)
  if (!learnItem) {
    return Astro.redirect('/404')
  }
} catch (error) {
  console.error('Failed to fetch learn item:', error)
  return Astro.redirect('/404')
}

// SEO optimization
const title = `${learnItem.title} | Learn | deTake`
const description = learnItem.description
const canonicalUrl = `${SITE_CONFIG.SITE_URL}/${locale}/learn/${slug}`

// Generate OG image
const ogImageParams = new URLSearchParams({
  title: learnItem.title,
  description: description,
  type: 'article'
})
const ogImageUrl = `${SITE_CONFIG.SITE_URL}/api/og/learn.svg?${ogImageParams.toString()}`

// Extract keywords
const keywords = ['learn', 'paragons', 'cryptocurrency', 'blockchain', learnItem.title.toLowerCase()]

// Format content - convert markdown-like content to HTML
function formatContent(content: string) {
  if (!content) return ''
  
  // Simple markdown-like parsing
  return content
    .replace(/## (.*)/g, '<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">$1</h2>')
    .replace(/### (.*)/g, '<h3 class="text-xl font-semibold text-gray-900 mt-6 mb-3">$1</h3>')
    .replace(/\n\n/g, '</p><p class="text-gray-700 leading-relaxed mb-4">')
    .replace(/^\s*/, '<p class="text-gray-700 leading-relaxed mb-4">')
    .replace(/\s*$/, '</p>')
}
---

<BaseLayout 
  title={title} 
  description={description} 
  locale={locale} 
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={`Learn about ${learnItem.title} on DeTake`}
  ogType="article"
  twitterCard="summary_large_image"
  keywords={keywords}
>
  <!-- React Header - Independent loading -->
  <HeaderWithFallback locale={locale} />
  
  <main class="min-h-screen mt-[56px] md:mt-[97px]">
    <!-- Breadcrumb -->
    <div class="max-w-[1440px] mx-auto px-4 py-6 hidden md:block">
      <nav class="text-sm text-gray-500">
        <a href={`/${locale}/learn`} class="hover:text-gray-700">Learn</a>
        <span class="mx-2">/</span>
        <a href={`/${locale}/learn`} class="hover:text-gray-700">Paragons</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">{learnItem.title}</span>
      </nav>
    </div>

    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3">
        <!-- Left Column - Article Content -->
        <div class="lg:col-span-2 pt-5 md:py-5 px-4 md:px-6 border border-t-0 border-border">
          <!-- Article Header -->
          <header class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-4">{learnItem.title}</h1>
            <div class="flex items-center gap-4 text-sm text-gray-500">
              <time datetime={learnItem.updatedAt}>
                {new Date(learnItem.updatedAt).toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span>•</span>
              <span>By JACK KUBINEC</span>
              <button class="ml-auto p-2 hover:bg-gray-100 rounded" title="Bookmark">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
              </button>
            </div>
          </header>

          <!-- Article Content -->
          <article class="prose prose-lg max-w-none">
            {learnItem.content ? (
              <div set:html={formatContent(learnItem.content)} />
            ) : (
              <p class="text-gray-700 leading-relaxed">{learnItem.description}</p>
            )}
          </article>

          <!-- Article Footer -->
          <footer class="mt-12 pt-8 border-t border-gray-200">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <span class="text-sm text-gray-500">Share this article:</span>
                <div class="flex gap-2">
                  <button class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                    </svg>
                  </button>
                  <button class="p-2 text-gray-500 hover:text-blue-800 hover:bg-blue-50 rounded">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </button>
                  <button class="p-2 text-gray-500 hover:text-green-600 hover:bg-green-50 rounded">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                    </svg>
                  </button>
                </div>
              </div>
              <a 
                href={`/${locale}/learn`}
                class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Paragons
              </a>
            </div>
          </footer>
        </div>
        
        <!-- Right Column - Sidebar Content -->
        <div class="lg:col-span-1 border border-t-0 border-l-0 border-border">
          <div class="sticky top-8">
            <div class="px-6 p-5">
              <RecentResearch locale={locale} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <!-- Footer -->
  <Footer client:load />
</BaseLayout>