---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount';
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro';
import type { Locale } from '@/types'
import Footer from '@/components/common/react/footer/Index';
import TopicPage from '@/components/pages/TopicPage';

export const prerender = false // Enable SSR for this page

// Extract Astro properties at the top
const { params, url, redirect } = Astro
const { locale, topic } = params as { locale: Locale; topic: string }

// Validate locale
if (!['us', 'asia'].includes(locale)) {
  return redirect('/404')
}

// Extract page parameter
const page = parseInt(url.searchParams.get('page') || '1', 10)

// Validate page number
const initialPage = Math.max(1, page)

// Convert topic slug back to display name
// Special handling for 'ai' to display as 'AI'
const topicDisplayName = topic.split('-').map(word => {
  if (word.toLowerCase() === 'ai') {
    return 'AI';
  }
  return word.charAt(0).toUpperCase() + word.slice(1);
}).join(' ')

// SEO content based on locale and topic
const seoContent = {
  us: {
    title: `${topicDisplayName} | DeTake`,
    description: `Explore articles about ${topicDisplayName} on DeTake - NATO's #1 Decentralized media network.`
  },
  asia: {
    title: `${topicDisplayName} - DeTake`,
    description: `在DeTake上探索关于${topicDisplayName}的文章 - NATO的#1去中心化媒体网络。`
  }
}

const { title, description } = seoContent[locale] || seoContent.us
---

<BaseLayout title={title} description={description} locale={locale}>
    <!-- React Header - Independent loading -->
    <HeaderWithFallback locale={locale} />
    <!-- AuthMount only manages wallet-related buttons -->
    <AuthMount client:load userButtonTargetId="user-button-root" />
    
    <div class="min-h-screen bg-background mt-[56px] md:mt-[97px]">
      <!-- Topic Header: simplified to match visual design (breadcrumb + large title) -->
      <div class="max-w-[1440px] mx-auto px-4 py-6 hidden md:block">
        <!-- Breadcrumb -->
        <nav class="text-sm text-muted-foreground mb-2">
          <a href={`/${locale}`} class="hover:text-foreground">
            Articles
          </a>
          <span class="mx-1">/</span>
          <span class="hover:text-foreground">
           Topics
          </span>
        </nav>
        
        <!-- Page Title -->
        <h1 class="text-4xl md:text-5xl font-medium text-foreground">{topicDisplayName}</h1>
        <p class="text-muted-foreground mt-2">{topicDisplayName}</p>
      </div>

      <!-- Topic Page Component -->
      <TopicPage 
        client:load
        locale={locale}
        topic={topicDisplayName}
        topicSlug={topic}
        initialPage={initialPage}
      />
      
      <!-- Footer -->
      <Footer client:load />
    </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>