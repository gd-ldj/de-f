---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount';
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro';
import type { Locale } from '@/types'
import Footer from '@/components/common/react/footer/Index';
import CategoryPage from '@/components/pages/CategoryPage';



export const prerender = false // Enable SSR for this page

// Extract Astro properties at the top
const { params, url, redirect } = Astro
const { locale, category } = params as { locale: Locale; category: string }



// Validate category against API data
const validCategories = ['insights', 'news', 'research']
if (!validCategories.includes(category.toLowerCase())) {
  return redirect('/404')
}

// Get initial URL parameters
const initialPage = parseInt(url.searchParams.get('page') || '1', 10)
const initialCategoryName = url.searchParams.get('category_name') || ''
const initialAuthorName = url.searchParams.get('author_name') || ''
const initialTag = url.searchParams.get('tag') || ''
const initialOrderBy = (url.searchParams.get('order_by') as 'Latest' | 'Popular' | 'Trending') || 'Latest'

const categoryDisplayName = category.charAt(0).toUpperCase() + category.slice(1)

// SEO content based on locale and category
const seoContent = {
  us: {
    title: `${categoryDisplayName} | DeTake`,
    description: `Follow NATO's #1 Decentralized media network to get yourself more must-see Takes. `
  },
  asia: {
    title: `${categoryDisplayName} - DeTake`,
    description: `关注NATO的#1去中心化媒体网络，获取更多必须看的Takes。`
  }
}

const { title, description } = seoContent[locale] || seoContent.us


---

<BaseLayout title={title} description={description} locale={locale}>
    <!-- React Header - Independent loading -->
    <HeaderWithFallback locale={locale} />
    <!-- AuthMount only manages wallet-related buttons -->
    <AuthMount client:load userButtonTargetId="user-button-root" />
    
    <!-- Main content area fills remaining height so that the footer sticks to the bottom when content is short -->
    <main class="flex-1 bg-background mt-[56px] md:mt-[97px]">
      <!-- Category Header: simplified to match visual design (breadcrumb + large title) -->
      <div class="max-w-[1440px] mx-auto px-4 py-6 hidden md:block">
        <!-- Breadcrumb -->
        <nav class="text-sm text-muted-foreground mb-2">
          <a href={`/${locale}`} class="hover:text-foreground">
            Articles
          </a>
          <span class="mx-1">/</span>
          <span class="text-primary">{categoryDisplayName}</span>
        </nav>
        
        <!-- Page Title -->
        <h1 class="text-4xl md:text-5xl font-medium text-foreground">{categoryDisplayName}</h1>
      </div>

      <!-- Category Page Component -->
      <CategoryPage 
        client:load
        locale={locale}
        category={categoryDisplayName}
        initialPage={initialPage}
        initialCategoryName={initialCategoryName}
        initialAuthorName={initialAuthorName}
        initialTag={initialTag}
        initialOrderBy={initialOrderBy}
      />
    </main>
    
    <!-- Footer -->
    <Footer client:load />
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
