---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/common/react/Header';
import ArticleLink from '@/components/common/astro/ArticleLink.astro'
import { fetchArticles } from '@/api/articles'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'
import type { Locale } from '@/types'
import Footer from '@/components/common/react/Footer';

import { changeLanguage } from "i18next";

changeLanguage(Astro.params.locale);
export const prerender = false // Enable SSR for this page

const { locale, category } = Astro.params as { locale: Locale; category: string }
const currentPath = Astro.url.pathname

// Validate category against API data
const validCategories = ['insights', 'news', 'research']
if (!validCategories.includes(category.toLowerCase())) {
  return Astro.redirect('/404')
}

// Fetch articles data for specific category
const articlesData = await fetchArticles(locale, 1, 12, category)
const { articles } = articlesData

// Category display names
const categoryNames = {
  insights: { en: 'Insights', zh: '洞察' },
  news: { en: 'News', zh: '新闻' },
  research: { en: 'Research', zh: '研究' }
}

const currentCategory = categoryNames[category.toLowerCase() as keyof typeof categoryNames]
const categoryDisplayName = locale === 'us' ? currentCategory.en : currentCategory.zh

// SEO content based on locale and category
const seoContent = {
  us: {
    title: `${currentCategory.en} - DeTake Crypto Analysis & Insights`,
    description: `Stay updated with the latest ${category} in cryptocurrency and blockchain. Expert analysis and insights from DeTake.`
  },
  asia: {
    title: `${currentCategory.zh} - DeTake 加密货币分析与洞察`,
    description: `获取最新的加密货币${currentCategory.zh}和区块链洞察。来自DeTake的专业分析。`
  }
}

const { title, description } = seoContent[locale] || seoContent.us

/**
 * Format date to readable string
 */
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

---

<BaseLayout title={title} description={description} locale={locale}>
    <div class="min-h-screen bg-background">
      <!-- Header Navigation -->
      <Header locale={locale} currentPath={currentPath} client:load />
      
      <!-- Category Header -->
      <div class="bg-card border-b border-border">
        <div class="max-w-7xl mx-auto px-4 py-6">
          <div class="flex items-center justify-between">
            <div>
              <h1 class="text-3xl font-bold text-foreground">{categoryDisplayName}</h1>
        <p class="text-muted-foreground mt-2">
                {category === 'insights' && (locale === 'us' 
                  ? 'In-depth analysis and interpretations of Web3 trends, technologies, and market dynamics'
                  : '深度分析和解读Web3趋势、技术和市场动态'
                )}
                {category === 'news' && (locale === 'us'
                  ? 'Current events, announcements, and breaking developments in the Web3 ecosystem'
                  : '当前事件、公告和Web3生态系统的突破性发展'
                )}
                {category === 'research' && (locale === 'us'
                  ? 'Comprehensive studies, technical papers, and data-driven investigations'
                  : '综合研究、技术论文和数据驱动的调查'
                )}
              </p>
            </div>
            
            <!-- Category Navigation -->
            <div class="flex items-center space-x-4">
              {Object.entries(categoryNames).map(([key, names]) => (
                <a 
                  href={`/${locale}/${key}`}
                  class={`px-4 py-2 rounded text-sm font-medium transition-colors ${
                    key === category.toLowerCase() 
                      ? 'bg-primary text-primary-foreground'
            : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
                  }`}
                >
                  {locale === 'us' ? names.en : names.zh}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
      
      <!-- Main Content Container -->
      <main class="max-w-[1440px] mx-auto px-4 py-8">
        <!-- Filter Bar -->
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center space-x-6">
            <button class="flex items-center space-x-2 px-4 py-2 bg-card border border-border rounded hover:bg-accent transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
              </svg>
              <span class="text-sm font-medium">{locale === 'us' ? 'Filters' : '筛选'}</span>
            </button>
            
            <!-- Category Filters -->
            <div class="flex items-center space-x-4">
              <span class="text-sm text-muted-foreground">{locale === 'us' ? 'Subcategory' : '子分类'}:</span>
          <select class="text-sm border border-border rounded-md px-3 py-1 bg-card">
                <option>{locale === 'us' ? 'All' : '全部'}</option>
                <option>{locale === 'us' ? 'Markets' : '市场'}</option>
                <option>{locale === 'us' ? 'Finance' : '金融'}</option>
                <option>{locale === 'us' ? 'Policy' : '政策'}</option>
              </select>
              
              <span class="text-sm text-muted-foreground">{locale === 'us' ? 'Author' : '作者'}:</span>
          <select class="text-sm border border-border rounded-md px-3 py-1 bg-card">
                <option>{locale === 'us' ? 'All Authors' : '所有作者'}</option>
                <option>John</option>
              </select>
              
              <span class="text-sm text-muted-foreground">{locale === 'us' ? 'Topic' : '主题'}:</span>
          <select class="text-sm border border-border rounded-md px-3 py-1 bg-card">
                <option value="">{locale === 'us' ? 'Select Topic' : '选择主题'}</option>
              </select>
            </div>
          </div>
          
          <!-- View Toggle -->
          <div class="flex items-center space-x-2">
            <button class="p-2 bg-card border border-border rounded-md hover:bg-accent">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
              </svg>
            </button>
            <button class="p-2 bg-secondary border border-border rounded-md">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
              </svg>
            </button>
          </div>
        </div>
        
        <!-- Articles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          {articles.map((article) => (
            <article class="bg-card rounded-xl border border-border overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <!-- Article Image -->
              <div class="relative">
                <ArticleLink 
                  slug={article.slug}
                  locale={locale}
                  category={article.category}
                  class="block group"
                >
                  <img 
                    src={article.featuredImage || '/placeholder.svg'} 
                    alt={article.title}
                    class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                  />
                </ArticleLink>
                <!-- Category Badge -->
                <div class="absolute top-4 left-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-card/90 text-card-foreground">
                    {categoryDisplayName}
                  </span>
                </div>
              </div>
              
              <!-- Article Content -->
              <div class="p-6">
                <h3 class="text-lg font-semibold text-foreground mb-3 line-clamp-2">
                  <ArticleLink 
                    slug={article.slug}
                    category={article.category}
                    locale={locale}
                    class="hover:text-primary transition-colors"
                  >
                    {article.title}
                  </ArticleLink>
                </h3>
                
                <p class="text-muted-foreground text-sm mb-4 line-clamp-3">
                  {article.excerpt}
                </p>
                
                <!-- Article Meta -->
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                  <div class="flex items-center space-x-2">
                    <span>{formatDate(article.publishedAt)}</span>
                    <span>•</span>
                    <span>by {article.author.name}</span>
                  </div>
                  <span>{article.readTime} {locale === 'us' ? 'min read' : '分钟阅读'}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
        
        <!-- Pagination -->
        <div class="flex items-center justify-center space-x-2">
          <button class="flex items-center px-3 py-2 text-sm text-muted-foreground hover:text-foreground transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            {locale === 'us' ? 'Prev' : '上一页'}
          </button>
          
          <div class="flex items-center space-x-1">
            <button class="px-3 py-2 text-sm bg-primary text-primary-foreground rounded-md">1</button>
            <button class="px-3 py-2 text-sm text-foreground hover:bg-accent rounded-md">2</button>
            <button class="px-3 py-2 text-sm text-foreground hover:bg-accent rounded-md">3</button>
            <span class="px-2 text-muted-foreground">...</span>
            <button class="px-3 py-2 text-sm text-foreground hover:bg-accent rounded-md">10</button>
          </div>
          
          <button class="flex items-center px-3 py-2 text-sm text-muted-foreground hover:text-foreground transition-colors">
            {locale === 'us' ? 'Next' : '下一页'}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </main>
      
      <!-- Footer -->
      <Footer client:load />
    </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
