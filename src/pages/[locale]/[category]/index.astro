---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount';
import ArticleLink from '@/components/common/astro/ArticleLink.astro'
import { fetchArticles } from '@/api/articles'
import { DEFAULT_PROMOTE_CODE, STORAGE_KEYS } from '@/config/constants'
import type { Locale } from '@/types'
import Footer from '@/components/common/react/footer/Index';
import FilterBar from '@/components/common/astro/FilterBar.astro'
import Pagination from '@/components/common/astro/Pagination.astro'

import { changeLanguage } from "i18next";

export const prerender = false // Enable SSR for this page

// Extract Astro properties at the top
const { params, url, redirect } = Astro
const { locale, category } = params as { locale: Locale; category: string }

// Initialize i18n with the locale from params
changeLanguage(locale);

// Validate category against API data
const validCategories = ['insights', 'news', 'research']
if (!validCategories.includes(category.toLowerCase())) {
  return redirect('/404')
}

// Get pagination parameters from URL
const currentPage = parseInt(url.searchParams.get('page') || '1', 10)
const itemsPerPage = 12

// Fetch articles data for specific category with pagination
const articlesData = await fetchArticles(locale, currentPage, itemsPerPage, {business_type_name: category.toLowerCase()})
// Use typed response directly (ArticlesResponse with ApiArticle[])
const { articles, total } = articlesData || { articles: [], total: 0 }
console.log("🚀 ~ articles:", articles)

// Category display names
const categoryNames = {
  insights: { en: 'Insights', zh: '洞察' },
  news: { en: 'News', zh: '新闻' },
  research: { en: 'Research', zh: '研究' }
}

const currentCategory = categoryNames[category.toLowerCase() as keyof typeof categoryNames]
const categoryDisplayName = locale === 'us' ? currentCategory.en : currentCategory.zh

// SEO content based on locale and category
const seoContent = {
  us: {
    title: `${currentCategory.en} - DeTake Crypto Analysis & Insights`,
    description: `Stay updated with the latest ${category} in cryptocurrency and blockchain. Expert analysis and insights from DeTake.`
  },
  asia: {
    title: `${currentCategory.zh} - DeTake 加密货币分析与洞察`,
    description: `获取最新的加密货币${currentCategory.zh}和区块链洞察。来自DeTake的专业分析。`
  }
}

const { title, description } = seoContent[locale] || seoContent.us

/**
 * Format date to readable string
 */
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

---

<BaseLayout title={title} description={description} locale={locale}>
    <!-- React mount point for Header - 移到最外层确保 sticky 生效 -->
    <div id="header-root"></div>
    <!-- Single React Island that contains IdentityProvider and portals -->
    <AuthMount client:load />
    
    <div class="min-h-screen bg-background mt-[65px]">
      <!-- Category Header: simplified to match visual design (breadcrumb + large title) -->
      <div class="max-w-[1440px] mx-auto px-4 py-6">
        <!-- Breadcrumb -->
        <nav class="text-sm text-muted-foreground mb-2">
          <a href={`/${locale}`} class="hover:text-foreground">
            {locale === 'us' ? 'Articles' : '文章'}
          </a>
          <span class="mx-1">/</span>
          <span class="text-primary">{categoryDisplayName}</span>
        </nav>
        
        <!-- Page Title -->
        <h1 class="text-4xl md:text-5xl font-medium text-foreground">{categoryDisplayName}</h1>
      </div>

      <!-- Main Content Container -->
      <main class="max-w-[1440px] mx-auto px-4 py-8">
        <!-- Filter Bar -->
        <FilterBar locale={locale} viewMode="grid" />

        <!-- Articles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12 mt-6">
          {articles.map((article) => (
            <article class=" rounded overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <!-- Article Image -->
              <div class="relative">
                <ArticleLink 
                  slug={article.slug}
                  locale={locale}
                  category={article.category_name}
                  class="block group"
                >
                  <img 
                    src={article.img_url || '/placeholder.svg'} 
                    alt={article.title}
                    class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                  />
                </ArticleLink>
              </div>
              
              <!-- Article Content -->
              <div class="p-6">
                <h3 class="text-lg font-medium text-foreground mb-3 line-clamp-2">
                  <ArticleLink 
                    slug={article.slug}
                    category={article.category_name}
                    locale={locale}
                    class="hover:text-primary transition-colors"
                  >
                    {article.title}
                  </ArticleLink>
                </h3>
                
                <p class="text-muted-foreground text-sm mb-4 line-clamp-3">
                  {article.sub_title}
                </p>
                
                <!-- Article Meta -->
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                  <div class="flex items-center space-x-1">
                    <span>{formatDate(article.created_at)}</span>
                    <span>/ by </span>
                    <span class="text-foreground">{article.author_name}</span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
        
        <!-- Dynamic Pagination -->
         <Pagination 
           currentPage={currentPage}
           totalItems={total}
           itemsPerPage={itemsPerPage}
           baseUrl={`/${locale}/${category}`}
           locale={locale}
         />
      </main>
      
      <!-- Footer -->
      <Footer client:load />
    </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
