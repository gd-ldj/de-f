---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount'
import Header from '@/components/common/react/header/Index'
import ArticleContent from '@/components/article/astro/ArticleContent.astro'
import ArticleSidebar from '@/components/article/react/ArticleSidebar'
// Removed: ShareSection direct import; it will be portaled by AuthMount
import { fetchArticle } from '@/api/articles'
import type { Locale } from '@/types'
import Footer from '@/components/common/react/footer/Index';


export const prerender = false // Enable SSR for this page

const { locale, category, slug } = Astro.params as { locale: Locale; category: string; slug: string }

// Validate category
const validCategories = ['insights', 'news', 'research']
if (!validCategories.includes(category.toLowerCase())) {
  return Astro.redirect('/404')
}

// Extract promote code from slug if present
// URL format: /locale/category/article-slug-promoteCode
let actualSlug = slug
let promoteCode = null

// Check if slug contains promote code (ends with -promoteCode pattern)
const slugParts = slug.split('-')
if (slugParts.length > 1) {
  // Last part might be promote code, check if it matches expected pattern
  const lastPart = slugParts[slugParts.length - 1]
  if (lastPart && lastPart.length >= 5) { // Promote codes are typically 5+ characters
    promoteCode = lastPart
    actualSlug = slugParts.slice(0, -1).join('-')
  }
}

// Fetch article data using the actual slug
const article = await fetchArticle(actualSlug, locale, category)

// Handle 404 if article not found
if (!article) {
  return Astro.redirect('/404')
}

// Category display names
const categoryNames = {
  insights: { en: 'Insights', zh: '洞察' },
  news: { en: 'News', zh: '新闻' },
  research: { en: 'Research', zh: '研究' }
}

const currentCategory = categoryNames[category.toLowerCase() as keyof typeof categoryNames]
const categoryDisplayName = locale === 'us' ? currentCategory.en : currentCategory.zh

// SEO optimization
const title = `${article.title} | ${categoryDisplayName} | deTake`
const description = article.sub_title
const canonicalUrl = `https://detake.com/${locale}/${category}/${slug}`

// 动态生成 OG 图片
const ogImageParams = new URLSearchParams({
  title: article.title,
  description: article.sub_title,
  category: categoryDisplayName,
  author: article?.author?.name || article.author_name || 'DeTake'
});
const ogImageUrl = article.img_url || `https://detake.com/api/og/article.svg?${ogImageParams.toString()}`

// 提取关键词和标签
const keywords = article.tags || []
const publishedTime = article.created_at
const modifiedTime = article.updated_at
const author = article?.author?.name || article.author_name
---

<BaseLayout 
  title={title} 
  description={description} 
  locale={locale} 
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={`${article.title} - ${categoryDisplayName} article on DeTake`}
  ogType="article"
  twitterCard="summary_large_image"
  author={author}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  keywords={keywords}
  articleSection={categoryDisplayName}
>
  <!-- React mount point for Header - 移到最外层确保 sticky 生效 -->
  <!-- React Header - 独立加载 -->
  <Header client:load />
  <!-- AuthMount 管理钱包相关按钮和分享、作者组件 -->
  <AuthMount 
    client:load 
    userButtonTargetId="user-button-root"
    shareSection={{ locale, title: article.title, url: canonicalUrl }}
    authorSection={{
      author: {
        id: article?.author?.id,
        name: article?.author?.name || article.author_name || '',
        avatar: article?.author?.avatar_url,
        bio: article?.author?.bio,
        email: article?.contact?.email,
        twitter: article?.contact?.twitter,
      },
      locale
    }}
  />
  
  <main class="min-h-screen mt-[56px] md:mt-[97px]">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3">
        <!-- Left Column - Article Content (SSR/ISR for SEO) -->
        <div class="lg:col-span-2 py-5 px-4 md:px-6 border border-t-0 border-border">
          <ArticleContent 
            article={article} 
            locale={locale} 
            category={category} 
            categoryDisplayName={categoryDisplayName} 
          />
        </div>
        
        <!-- Right Column - Data Display (React Components) -->
        <div class="lg:col-span-1 border border-t-0 border-l-0 border-border">
          <div class="top-8">
            <!-- Share Section mount: rendered via AuthMount under PrivyProvider -->
            <div id="share-section-root" class=""></div>
            <!-- <ArticleSidebar locale={locale} client:load /> -->
          </div>
        </div>
      </div>
    </div>
  </main>
  <!-- Footer -->
      <Footer client:load />
</BaseLayout>

<style>
  .prose {
    color: hsl(var(--foreground));
  }
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  .prose a {
    color: hsl(var(--primary));
    text-decoration: none;
  }
  .prose a:hover {
    text-decoration: underline;
  }
  .prose blockquote {
    border-left: 4px solid hsl(var(--primary));
    padding-left: 1rem;
    font-style: italic;
    color: hsl(var(--muted-foreground));
  }
  .prose code {
    background-color: hsl(var(--secondary));
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .prose pre {
    background-color: hsl(var(--secondary));
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
</style>