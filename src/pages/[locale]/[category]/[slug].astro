---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount'
import ArticleContent from '@/components/article/astro/ArticleContent.astro'
import ArticleSidebar from '@/components/article/react/ArticleSidebar'
// Removed: ShareSection direct import; it will be portaled by AuthMount
import { fetchArticle } from '@/api/articles'
import type { Locale } from '@/types'


export const prerender = false // Enable SSR for this page

const { locale, category, slug } = Astro.params as { locale: Locale; category: string; slug: string }
const currentPath = Astro.url.pathname

// Validate category
const validCategories = ['insights', 'news', 'research']
if (!validCategories.includes(category.toLowerCase())) {
  return Astro.redirect('/404')
}

// Extract promote code from slug if present
// URL format: /locale/category/article-slug-promoteCode
let actualSlug = slug
let promoteCode = null

// Check if slug contains promote code (ends with -promoteCode pattern)
const slugParts = slug.split('-')
if (slugParts.length > 1) {
  // Last part might be promote code, check if it matches expected pattern
  const lastPart = slugParts[slugParts.length - 1]
  if (lastPart && lastPart.length >= 5) { // Promote codes are typically 5+ characters
    promoteCode = lastPart
    actualSlug = slugParts.slice(0, -1).join('-')
  }
}

// Fetch article data using the actual slug
const article = await fetchArticle(locale, actualSlug, category)

// Handle 404 if article not found
if (!article) {
  return Astro.redirect('/404')
}

// Category display names
const categoryNames = {
  insights: { en: 'Insights', zh: '洞察' },
  news: { en: 'News', zh: '新闻' },
  research: { en: 'Research', zh: '研究' }
}

const currentCategory = categoryNames[category.toLowerCase() as keyof typeof categoryNames]
const categoryDisplayName = locale === 'us' ? currentCategory.en : currentCategory.zh

// SEO optimization
const title = `${article.title} | ${categoryDisplayName} | DeTake`
const description = article.excerpt
const canonicalUrl = `https://detake.com/${locale}/${category}/${slug}`
---

<BaseLayout title={title} description={description} locale={locale} canonicalUrl={canonicalUrl}>
  <> {/* Article-specific meta tags */}
    <!-- Article-specific meta tags -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={article.title} />
    <meta property="og:description" content={article.excerpt} />
    <meta property="og:url" content={canonicalUrl} />
    {article.featuredImage && (
      <meta property="og:image" content={article.featuredImage} />
    )}
    <meta property="article:published_time" content={article.publishedAt} />
    <meta property="article:modified_time" content={article.updatedAt} />
    <meta property="article:author" content={article.author.name} />
    <meta property="article:section" content={categoryDisplayName} />
    {article.tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={article.title} />
    <meta name="twitter:description" content={article.excerpt} />
    {article.featuredImage && (
      <meta name="twitter:image" content={article.featuredImage} />
    )}
  </>

  <!-- React mount point for Header - 移到最外层确保 sticky 生效 -->
  <div id="header-root"></div>
  <!-- React island: contains PrivyProvider and portals -->
  <AuthMount 
    locale={locale} 
    currentPath={currentPath} 
    client:load 
    shareSection={{ locale, title: article.title, url: canonicalUrl }}
    authorSection={{
      author: {
        name: article.author.name,
        avatar: article.author.avatar
      },
      locale
    }}
  />
  
  <main class="min-h-screen mt-[65px]">
    <div class="max-w-[1440px] mx-auto px-4 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column - Article Content (SSR/ISR for SEO) -->
        <div class="lg:col-span-2">
          <ArticleContent 
            article={article} 
            locale={locale} 
            category={category} 
            categoryDisplayName={categoryDisplayName} 
          />
        </div>
        
        <!-- Right Column - Data Display (React Components) -->
        <div class="lg:col-span-1">
          <div class="sticky top-8">
            <!-- Share Section mount: rendered via AuthMount under PrivyProvider -->
            <div id="share-section-root" class="mb-8"></div>
            <ArticleSidebar locale={locale} client:load />
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .prose {
    color: hsl(var(--foreground));
  }
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  .prose a {
    color: hsl(var(--primary));
    text-decoration: none;
  }
  .prose a:hover {
    text-decoration: underline;
  }
  .prose blockquote {
    border-left: 4px solid hsl(var(--primary));
    padding-left: 1rem;
    font-style: italic;
    color: hsl(var(--muted-foreground));
  }
  .prose code {
    background-color: hsl(var(--secondary));
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .prose pre {
    background-color: hsl(var(--secondary));
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
</style>