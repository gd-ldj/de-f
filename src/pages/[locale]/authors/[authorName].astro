---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AuthMount from '@/components/common/react/AuthMount'
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro'
import AuthorProfileSection from '@/components/author/astro/AuthorProfileSection.astro'
import AuthorTabs from '@/components/author/astro/AuthorTabs.astro'
import { fetchAuthorProfile } from '@/api/users'
import { fetchArticles } from '@/api/articles'
import type { Locale } from '@/types'
import Footer from '@/components/common/react/footer/Index'
import RecentResearch from '@/components/article/astro/RecentResearch.astro'
import { SITE_CONFIG } from '@/config/constants'

export const prerender = false // Enable SSR for this page

const { locale, authorName } = Astro.params as { locale: Locale; authorName: string }

// Validate locale
const validLocales = ['us', 'asia']
if (!validLocales.includes(locale)) {
  return Astro.redirect('/404')
}

// Decode author name from URL
const decodedAuthorName = decodeURIComponent(authorName)

// Fetch author profile data
const authorProfile = await fetchAuthorProfile(decodedAuthorName)

// Handle 404 if author not found
if (!authorProfile) {
  return Astro.redirect('/404')
}

// Fetch author's articles
const articlesResponse = await fetchArticles(locale, 1, 10, {
  author_name: decodedAuthorName,
  order_by: 'Latest'
})

const articles = articlesResponse?.articles || []

// SEO optimization
const title = `${authorProfile.name} | Author Profile | deTake`
const description = authorProfile.profile_bio || `Articles and insights by ${authorProfile.name} on deTake`
const canonicalUrl = `${SITE_CONFIG.SITE_URL}/${locale}/authors/${encodeURIComponent(authorName)}`

// Generate OG image for author
const ogImageParams = new URLSearchParams({
  title: authorProfile.name,
  description: description,
  type: 'website'
});
const ogImageUrl = authorProfile.avatar_url || `${SITE_CONFIG.SITE_URL}/api/og/author.svg?${ogImageParams.toString()}`

// Extract keywords
const keywords = ['author', 'profile', authorProfile.name, 'cryptocurrency', 'blockchain', 'analysis']
---

<BaseLayout 
  title={title} 
  description={description} 
  locale={locale} 
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={`${authorProfile.name} - Author profile on DeTake`}
  ogType="website"
  twitterCard="summary_large_image"
  author={authorProfile.name}
  keywords={keywords}
>
  <!-- React Header - Independent loading -->
  <HeaderWithFallback locale={locale} />

    <main class="min-h-screen mt-[56px] md:mt-[97px]">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[1000px_440px]">
        <!-- Left Column - Article Content (SSR/ISR for SEO) -->
        <div class="pt-5 md:pt-8 md:py-5 px-4 md:px-6 border border-t-0 border-border">
          <div class="mb-4">
            <nav class="text-sm text-muted-foreground mb-2">
              <a href={`/${locale}`} class="hover:text-foreground">
                Social Media
              </a>
              <span class="mx-1">/</span>
              <span class="text-primary">Authors</span>
            </nav>
          </div>
          <!-- Author Profile Section -->
          <AuthorProfileSection 
            authorProfile={authorProfile}
            locale={locale}
          />
          
          <!-- Author Tabs Section -->
          <AuthorTabs
            articles={articles}
            authorName={decodedAuthorName}
            locale={locale}
            hasMore={articlesResponse?.hasMore || false}
            nextCursor={articlesResponse?.nextCursor || undefined}
          />
        </div>
        
        <!-- Right Column - Data Display (React Components) -->
        <div class="border border-t-0 border-l-0 border-border">
          <div class="top-8">
            <!-- Share Section mount: rendered via AuthMount under PrivyProvider -->
            <div id="share-section-root" class=""></div>
            <!-- <ArticleSidebar locale={locale} client:load /> -->
            <div class="px-6 p-5">
              <RecentResearch locale={locale} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <!-- Footer -->
  <Footer client:load />
</BaseLayout>
