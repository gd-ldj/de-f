---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/common/react/Header'
import PrivyProvider from '@/components/common/react/PrivyProvider'
import { fetchArticle, fetchArticles } from '@/api/articles'
import type { Locale } from '@/types'

export const prerender = false // Enable SSR for this page

const { locale, slug } = Astro.params as { locale: Locale; slug: string }
const currentPath = Astro.url.pathname

// Fetch article data
const article = await fetchArticle(locale, slug)

// Handle 404 if article not found
if (!article) {
  return Astro.redirect('/404')
}

// Format date function
const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString(locale === 'us' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  })
}

// SEO optimization
const title = `${article.title} | DeTake`
const description = article.excerpt
const canonicalUrl = `https://detake.com/${locale}/news/${slug}`
---

<BaseLayout title={title} description={description} locale={locale} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <!-- Article-specific meta tags -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={article.title} />
    <meta property="og:description" content={article.excerpt} />
    <meta property="og:url" content={canonicalUrl} />
    {article.featuredImage && (
      <meta property="og:image" content={article.featuredImage} />
    )}
    <meta property="article:published_time" content={article.publishedAt} />
    <meta property="article:modified_time" content={article.updatedAt} />
    <meta property="article:author" content={article.author.name} />
    <meta property="article:section" content={article.category} />
    {article.tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={article.title} />
    <meta name="twitter:description" content={article.excerpt} />
    {article.featuredImage && (
      <meta name="twitter:image" content={article.featuredImage} />
    )}
    
    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": article.title,
      "description": article.excerpt,
      "image": article.featuredImage,
      "author": {
        "@type": "Person",
        "name": article.author.name
      },
      "publisher": {
        "@type": "Organization",
        "name": "DeTake",
        "logo": {
          "@type": "ImageObject",
          "url": "https://detake.com/logo.png"
        }
      },
      "datePublished": article.publishedAt,
      "dateModified": article.updatedAt,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      }
    })} />
  </Fragment>

  <PrivyProvider>
    <Header locale={locale} currentPath={currentPath} client:load />
    
    <main class="flex-1">
      <article class="py-8 md:py-12">
        <div class="container max-w-4xl">
          <!-- Article Header -->
          <header class="mb-8">
            <!-- Breadcrumb -->
            <nav class="flex items-center space-x-2 text-sm text-muted-foreground mb-6">
              <a href={`/${locale}`} class="hover:text-primary">Home</a>
              <span>/</span>
              <a href={`/${locale}/news`} class="hover:text-primary">News</a>
              <span>/</span>
              <span class="text-foreground">{article.title}</span>
            </nav>

            <!-- Category and Read Time -->
            <div class="flex items-center space-x-4 mb-4">
              <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
                {article.category}
              </span>
              <span class="text-sm text-muted-foreground">
                {article.readTime} {locale === 'us' ? 'min read' : '分钟阅读'}
              </span>
            </div>

            <!-- Title -->
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-6">
              {article.title}
            </h1>

            <!-- Excerpt -->
            <p class="text-xl text-muted-foreground mb-8">
              {article.excerpt}
            </p>

            <!-- Author and Date -->
            <div class="flex items-center space-x-4 pb-8 border-b">
              <div class="flex items-center space-x-3">
                {article.author.avatar ? (
                  <img
                    src={article.author.avatar}
                    alt={article.author.name}
                    class="h-12 w-12 rounded-full"
                  />
                ) : (
                  <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                    <span class="text-primary-foreground font-medium">
                      {article.author.name.charAt(0).toUpperCase()}
                    </span>
                  </div>
                )}
                <div>
                  <p class="font-medium">{article.author.name}</p>
                  <time class="text-sm text-muted-foreground" datetime={article.publishedAt}>
                    {formatDate(article.publishedAt)}
                  </time>
                </div>
              </div>
            </div>
          </header>

          <!-- Featured Image -->
          {article.featuredImage && (
            <div class="mb-8">
              <img
                src={article.featuredImage}
                alt={article.title}
                class="w-full h-auto rounded-lg shadow-lg"
                loading="lazy"
              />
            </div>
          )}

          <!-- Article Content -->
          <div class="prose prose-lg max-w-none">
            <div set:html={article.content} />
          </div>

          <!-- Tags -->
          {article.tags.length > 0 && (
            <div class="mt-12 pt-8 border-t">
              <h3 class="text-lg font-semibold mb-4">
                {locale === 'us' ? 'Tags' : '标签'}
              </h3>
              <div class="flex flex-wrap gap-2">
                {article.tags.map((tag) => (
                  <a
                    href={`/${locale}/tag/${tag}`}
                    class="inline-flex items-center rounded-md bg-secondary px-3 py-1 text-sm font-medium text-secondary-foreground hover:bg-secondary/80"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Share Section -->
          <div class="mt-12 pt-8 border-t">
            <h3 class="text-lg font-semibold mb-4">
              {locale === 'us' ? 'Share this article' : '分享这篇文章'}
            </h3>
            <div class="flex space-x-4">
              <button
                onclick={`window.open('https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalUrl)}&text=${encodeURIComponent(article.title)}', '_blank')`}
                class="flex items-center space-x-2 px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition-colors"
              >
                <span>Twitter</span>
              </button>
              <button
                onclick={`window.open('https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}', '_blank')`}
                class="flex items-center space-x-2 px-4 py-2 bg-blue-700 text-white rounded-md hover:bg-blue-800 transition-colors"
              >
                <span>LinkedIn</span>
              </button>
              <button
                onclick={`navigator.clipboard.writeText('${canonicalUrl}')`}
                class="flex items-center space-x-2 px-4 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700 transition-colors"
              >
                <span>{locale === 'us' ? 'Copy Link' : '复制链接'}</span>
              </button>
            </div>
          </div>
        </div>
      </article>

      <!-- Related Articles Section -->
      <section class="py-12 bg-secondary/20">
        <div class="container max-w-6xl">
          <h2 class="text-2xl font-bold mb-8">
            {locale === 'us' ? 'Related Articles' : '相关文章'}
          </h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <!-- Related articles would be loaded here -->
            <div class="text-center text-muted-foreground py-8">
              {locale === 'us' ? 'Loading related articles...' : '加载相关文章中...'}
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t bg-background">
      <div class="container py-8 md:py-12">
        <div class="text-center text-sm text-muted-foreground">
          <p>&copy; 2024 DeTake. {locale === 'us' ? 'All rights reserved.' : '保留所有权利。'}</p>
        </div>
      </div>
    </footer>
  </PrivyProvider>
</BaseLayout>

<style>
  .prose {
    color: hsl(var(--foreground));
  }
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  .prose a {
    color: hsl(var(--primary));
    text-decoration: none;
  }
  .prose a:hover {
    text-decoration: underline;
  }
  .prose blockquote {
    border-left: 4px solid hsl(var(--primary));
    padding-left: 1rem;
    font-style: italic;
    color: hsl(var(--muted-foreground));
  }
  .prose code {
    background-color: hsl(var(--secondary));
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .prose pre {
    background-color: hsl(var(--secondary));
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
</style>