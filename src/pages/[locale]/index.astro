---
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Locale } from '@/types'
import MobileLayout from '@/components/home/astro/MobileLayout.astro'
import Sidebar from '@/components/home/astro/Sidebar.astro';
import MainContent from '@/components/home/astro/MainContent.astro';
import RightSidebar from '@/components/home/astro/RightSidebar.astro';
import NewsSection from '@/components/home/astro/NewsSection.astro';
import TrendingSection from '@/components/home/astro/TrendingSection.astro';
import ResearchSection from '@/components/home/astro/ResearchSection.astro';
import Footer from '@/components/common/react/footer/Index';
import AuthMount from '@/components/common/react/AuthMount';
import Header from '@/components/common/react/header/Index';
import ToFollowList from '@/components/home/react/ToFollowList';



export const prerender = false // Enable SSR for this page

const { locale } = Astro.params as { locale: Locale }



// SEO content based on locale
const seoContent = {
  us: {
    title: 'DeTake - Decentralized takes',
    description: 'Follow NATO\'s #1 Decentralized media network to get yourself more must-see Takes.'
  },
  asia: {
    title: 'DeTake - 去中心化的Takes',
    description: '关注NATO的#1去中心化媒体网络，获取更多必须看的Takes。'
  }
}

const { title, description } = seoContent[locale] || seoContent.us
---

<BaseLayout title={title} description={description} locale={locale}>
     <!-- React Header - 独立加载 -->
     <Header client:load />
     <!-- AuthMount 只管理钱包相关按钮 -->
     <AuthMount 
       client:load 
       userButtonTargetId="user-button-root"
     />
     <!-- 移动端布局 -->
     <div class="md:hidden mt-[56px]">
        <MobileLayout locale={locale} />
     </div>
     <div class="min-h-screen bg-white mt-[97px] md:block hidden">
        
        <div class="max-w-[1440px] mx-auto">
          <div class="grid grid-cols-12">
            <div class="col-span-3 space-y-6 py-5 border border-t-0 border-r-0 border-border">
              <Sidebar />
                <ToFollowList locale={locale} client:load />
            </div>
            <div class="col-span-6 border border-t-0 border-border py-5 px-6">
              <MainContent locale={locale} />
            </div>
            <div class="col-span-3 space-y-6 py-5 border border-t-0 border-l-0 border-border">
              <!-- React mount point for Login -->
              <div id="login-root" ></div>
              <RightSidebar />
            </div>
          </div>
          <NewsSection locale={locale} />
          <TrendingSection />
          <ResearchSection locale={locale} />
        </div>
      </div>
      <Footer  client:load />

</BaseLayout>
