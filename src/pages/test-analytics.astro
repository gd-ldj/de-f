---
import BaseLayout from '../layouts/BaseLayout.astro'
import TurnstileVerification from '../components/common/react/TurnstileVerification'
---

<BaseLayout 
  title="Analytics & Verification Test - DeTake"
  description="Test page for analytics tracking and Cloudflare Turnstile verification"
  locale="us"
>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <h1 class="text-3xl font-bold mb-8">Analytics & Verification Test</h1>
    
    <!-- Analytics Demo Section -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">User Behavior Tracking Demo</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Article Cards for Testing -->
        <div class="bg-white rounded shadow-md p-6">
          <h3 class="text-xl font-semibold mb-3">Sample Article 1</h3>
          <p class="text-gray-600 mb-4">
            This is a sample article for testing analytics tracking. 
            Click on the link below to test article view tracking.
          </p>
          <a 
            href="/us/news/sample-article-1" 
            class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
            data-article-id="sample-1"
            onclick="trackArticleClick('sample-1', 'Sample Article 1')"
          >
            Read Article
          </a>
          <button 
            class="ml-2 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition-colors"
            onclick="trackArticleShare('sample-1', 'twitter')"
          >
            Share on Twitter
          </button>
        </div>
        
        <div class="bg-white rounded shadow-md p-6">
          <h3 class="text-xl font-semibold mb-3">Sample Article 2</h3>
          <p class="text-gray-600 mb-4">
            Another sample article for testing different tracking scenarios.
            This helps test multiple article interactions.
          </p>
          <a 
            href="/us/news/sample-article-2" 
            class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
            data-article-id="sample-2"
            onclick="trackArticleClick('sample-2', 'Sample Article 2')"
          >
            Read Article
          </a>
          <button 
            class="ml-2 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition-colors"
            onclick="trackArticleShare('sample-2', 'facebook')"
          >
            Share on Facebook
          </button>
        </div>
      </div>
      
      <!-- Analytics Controls -->
      <div class="mt-8 bg-gray-50 rounded p-6">
        <h3 class="text-lg font-semibold mb-4">Analytics Controls</h3>
        <div class="flex flex-wrap gap-3">
          <button 
            class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 transition-colors"
            onclick="triggerCustomEvent()"
          >
            Trigger Custom Event
          </button>
          <button 
            class="bg-orange-600 text-white px-4 py-2 rounded hover:bg-orange-700 transition-colors"
            onclick="showVisitorInfo()"
          >
            Show Visitor Info
          </button>
          <button 
            class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 transition-colors"
            onclick="clearAnalyticsData()"
          >
            Clear Analytics Data
          </button>
        </div>
      </div>
    </section>
    
    <!-- Turnstile Verification Section -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Cloudflare Turnstile Verification</h2>
      
      <div class="bg-white rounded shadow-md p-6">
        <p class="text-gray-600 mb-6">
          This section demonstrates Cloudflare Turnstile verification for bot protection.
          The verification widget below helps filter out automated traffic.
        </p>
        
        <div class="mb-6">
          <TurnstileVerification 
            client:load
            onVerify={(token) => {
              isVerified = true
              document.getElementById('verification-status').innerHTML = 
                '<span class="text-green-600 font-semibold">✓ Verification successful!</span>'
              logEvent(`Turnstile verification successful: ${token.substring(0, 20)}...`)
            }}
            onError={(error) => {
              isVerified = false
              document.getElementById('verification-status').innerHTML = 
                `<span class="text-red-600 font-semibold">✗ Verification failed: ${error}</span>`
              logEvent(`Turnstile verification failed: ${error}`)
            }}
            size="normal"
            theme="auto"
            className="mb-4"
          />
        </div>
        
        <div id="verification-status" class="text-sm text-gray-600">
          Verification status will appear here...
        </div>
      </div>
    </section>
    
    <!-- Analytics Dashboard -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Real-time Analytics Dashboard</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded shadow-md p-6">
          <h3 class="text-lg font-semibold mb-2">Page Views</h3>
          <div id="page-views" class="text-3xl font-bold text-blue-600">-</div>
          <div class="text-sm text-gray-500">Current session</div>
        </div>
        
        <div class="bg-white rounded shadow-md p-6">
          <h3 class="text-lg font-semibold mb-2">Time on Page</h3>
          <div id="time-on-page" class="text-3xl font-bold text-green-600">-</div>
          <div class="text-sm text-gray-500">Seconds</div>
        </div>
        
        <div class="bg-white rounded shadow-md p-6">
          <h3 class="text-lg font-semibold mb-2">Scroll Depth</h3>
          <div id="scroll-depth" class="text-3xl font-bold text-purple-600">-</div>
          <div class="text-sm text-gray-500">Percentage</div>
        </div>
      </div>
    </section>
    
    <!-- Event Log -->
    <section>
      <h2 class="text-2xl font-semibold mb-6">Event Log</h2>
      
      <div class="bg-gray-900 text-green-400 rounded p-4 font-mono text-sm max-h-96 overflow-y-auto">
        <div id="event-log">
          <div class="text-gray-500">[Analytics] Event log will appear here...</div>
        </div>
      </div>
      
      <div class="mt-4">
        <button 
          class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition-colors"
          onclick="clearEventLog()"
        >
          Clear Log
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Global variables for demo
  let pageStartTime = Date.now()
  let eventCount = 0
  let isVerified = false
  
  // Track article click
  function trackArticleClick(articleId, title) {
    if ((window as any).detakeAnalytics) {
      (window as any).detakeAnalytics.trackArticleView(articleId, title, 'demo')
      logEvent(`Article clicked: ${title} (${articleId})`)
    }
  }
  
  // Track article share
  function trackArticleShare(articleId, platform) {
    if ((window as any).detakeAnalytics) {
      (window as any).detakeAnalytics.trackArticleShare(articleId, platform)
      logEvent(`Article shared: ${articleId} on ${platform}`)
    }
  }
  
  // Trigger custom event
  function triggerCustomEvent() {
    if ((window as any).detakeAnalytics) {
      (window as any).detakeAnalytics.trackEvent('custom_demo_event', {
        demoAction: 'button_click',
        timestamp: Date.now()
      })
      logEvent('Custom demo event triggered')
    }
  }
  
  // Show visitor information
  function showVisitorInfo() {
    if ((window as any).detakeAnalytics) {
      const visitorData = (window as any).detakeAnalytics.getVisitorData()
      if (visitorData) {
        alert(`Visitor ID: ${visitorData.visitorId}\nSession ID: ${visitorData.sessionId}\nGA Client ID: ${visitorData.gaClientId || 'Not available'}`)
        logEvent('Visitor info displayed')
      }
    }
  }
  
  // Clear analytics data
  function clearAnalyticsData() {
    localStorage.removeItem('visitor_id')
    localStorage.removeItem('ga_client_id')
    localStorage.removeItem('user_behavior_data')
    logEvent('Analytics data cleared')
    alert('Analytics data cleared. Refresh the page to reinitialize.')
  }
  

  
  // Log event to console and UI
  function logEvent(message) {
    const timestamp = new Date().toLocaleTimeString()
    const logEntry = `[${timestamp}] ${message}`
    
    console.log(logEntry)
    
    const eventLog = document.getElementById('event-log')
    if (eventLog) {
      const logDiv = document.createElement('div')
      logDiv.textContent = logEntry
      eventLog.appendChild(logDiv)
      eventLog.scrollTop = eventLog.scrollHeight
    }
    
    eventCount++
  }
  
  // Clear event log
  function clearEventLog() {
    const eventLog = document.getElementById('event-log')
    if (eventLog) {
      eventLog.innerHTML = '<div class="text-gray-500">[Analytics] Event log cleared...</div>'
    }
  }
  
  // Update dashboard metrics
  function updateDashboard() {
    const timeOnPage = Math.floor((Date.now() - pageStartTime) / 1000)
    
    // Update time on page
    const timeElement = document.getElementById('time-on-page')
    if (timeElement) {
      timeElement.textContent = timeOnPage
    }
    
    // Update page views (for demo, just show event count)
    const pageViewsElement = document.getElementById('page-views')
    if (pageViewsElement) {
      pageViewsElement.textContent = eventCount
    }
    
    // Update scroll depth
    const scrollDepth = Math.round(
      (window.pageYOffset / (document.documentElement.scrollHeight - window.innerHeight)) * 100
    ) || 0
    
    const scrollElement = document.getElementById('scroll-depth')
    if (scrollElement) {
      scrollElement.textContent = `${scrollDepth}%`
    }
  }
  
  // Initialize dashboard updates
  document.addEventListener('DOMContentLoaded', () => {
    // Update dashboard every second
    setInterval(updateDashboard, 1000)
    
    // Log initial page load
    logEvent('Analytics test page loaded')
    
    // Track scroll events
    let scrollTimeout
    window.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout)
      scrollTimeout = setTimeout(() => {
        updateDashboard()
      }, 100)
    })
  })
</script>

<style>
  /* Custom styles for the analytics demo */
  .container {
    animation: fadeIn 0.5s ease-in;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  #event-log {
    line-height: 1.4;
  }
  
  #event-log div {
    margin-bottom: 2px;
  }
</style>