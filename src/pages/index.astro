---
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Locale, SourceLanguage } from '@/types'
import MobileLayout from '@/components/home/astro/MobileLayout.astro'
import Sidebar from '@/components/home/astro/Sidebar.astro';
import MainContent from '@/components/home/astro/MainContent.astro';
import RightSidebar from '@/components/home/astro/RightSidebar.astro';
import NewsSection from '@/components/home/astro/NewsSection.astro';
import TrendingSection from '@/components/home/astro/TrendingSection.astro';
import ResearchSection from '@/components/home/astro/ResearchSection.astro';
import Footer from '@/components/common/react/footer/Index';
import HeaderWithFallback from '@/components/common/astro/HeaderWithFallback.astro';
import { fetchHomePageData } from '@/api/articles';
import { MULTI_SOURCE_CONFIG } from '@/config/constants';
import { getSourceLanguageFromRequest } from '@/lib/language-utils';

export const prerender = false

const sourceLanguage: SourceLanguage = getSourceLanguageFromRequest(Astro.request, Astro.url.hostname)
const locale: Locale = MULTI_SOURCE_CONFIG.languageToLocale(sourceLanguage)

const userAgent = Astro.request.headers.get('user-agent') || ''
const isMobileUserAgent = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(userAgent)

const homeData = await fetchHomePageData(locale)

const seoContent = {
  en: {
    title: 'DeTake - Decentralized takes',
    description: 'Follow NATO\'s #1 Decentralized media network to get yourself more must-see Takes.'
  },
  zh: {
    title: 'DeTake - 去中心化的Takes',
    description: '关注NATO的#1去中心化媒体网络，获取更多必须看的Takes。'
  },
  ja: {
    title: 'DeTake - Decentralized takes',
    description: 'Follow NATO\'s #1 Decentralized media network to get yourself more must-see Takes.'
  }
}

const { title, description } = seoContent[locale] || seoContent.en
---

<BaseLayout title={title} description={description} locale={locale}>
  <HeaderWithFallback locale={locale} />
  <main>
  {isMobileUserAgent && (
    <div class="md:hidden mt-[56px]">
      <MobileLayout
        locale={locale}
        latestNews={homeData?.lastest || []}
        newsAll={homeData?.news_all || []}
        whoToFollow={homeData?.who_to_follow || []}
        topics={homeData?.topics || []}
        mostRead={homeData?.mostread || []}
        news={homeData?.news || []}
        insights={homeData?.insights || []}
        research={homeData?.research || []}
      />
    </div>
  )}
  <div class="min-h-screen bg-white mt-[97px] md:block hidden">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-12">
        <div class="col-span-3 py-5 border border-t-0 border-r-0 border-border">
          <Sidebar locale={locale} latestNews={homeData?.lastest || []} />
        </div>
        <div class="col-span-6 border border-t-0 border-border py-5 px-6">
          <MainContent locale={locale} newsAll={homeData?.news_all || []} />
        </div>
        <div class="col-span-3 space-y-6 py-5 border border-t-0 border-l-0 border-border">
          <RightSidebar locale={locale} topics={homeData?.topics || []} mostRead={homeData?.mostread || []} />
        </div>
      </div>
      <NewsSection locale={locale} articles={homeData?.news || []} />
      <TrendingSection locale={locale} articles={homeData?.insights || []} />
      <ResearchSection locale={locale} articles={homeData?.research || []} />
    </div>
  </div>
  </main>
  <Footer client:load locale={locale} />
</BaseLayout>
